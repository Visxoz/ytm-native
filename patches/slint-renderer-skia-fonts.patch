+    fn load_typeface_internal(&mut self, font: &parley::FontData) -> Option<skia_safe::Typeface> {
+        // Patched for ytm-native: system fonts arrive memory-mapped, and a
+        // copy of each made the process privately hold every fallback font
+        // it touched, some 10 to 35 MB apiece for CJK and emoji. The blob is
+        // kept alive for the life of the process instead, so Skia can read
+        // the mapping directly; typefaces may outlive this cache's entries.
+        if self.pinned.insert(font.data.id()) {
+            std::mem::forget(font.data.clone());
+        }
+        // SAFETY: the blob was leaked above, so its bytes are never freed.
+        let data = unsafe { skia_safe::Data::new_bytes(font.data.as_ref()) };
+        let typeface = self
+            .font_mgr
+            .new_from_data(data, if font.index > 0 { Some(font.index as _) } else { None });
 
