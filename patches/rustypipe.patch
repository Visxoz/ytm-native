+/// What tells apart the logins `Cookie` headers are for.
+fn cookie_login(cookie: &str) -> Option<&str> {
+    let value = |name: &str| {
+        cookie
+            .split(';')
+            .find_map(|c| c.trim().strip_prefix(name)?.strip_prefix('='))
+    };
+    value("SAPISID").or_else(|| value("__Secure-3PAPISID"))
+}
+
+/// `cookie` with the youtube.com-wide cookies of `set_cookie` (`Set-Cookie`
+/// values) put in by name, or `None` when that changes nothing. Deletions are
+/// left out, so a session is only ever ended by signing out.
+pub fn merge_set_cookies<'c, 's: 'c>(
+    cookie: &'c str,
+    set_cookie: impl IntoIterator<Item = &'s str>,
+) -> Option<String> {
+    let this_year = OffsetDateTime::now_utc().year();
+    let mut jar: Vec<(&str, &str)> = cookie
+        .split(';')
+        .filter_map(|c| c.trim().split_once('='))
+        .collect();
+    let mut changed = false;
+    for line in set_cookie {
+        let mut attrs = line.split(';').map(|a| {
+            let a = a.trim();
+            a.split_once('=').unwrap_or((a, ""))
+        });
+        let Some((name, value)) = attrs.next() else {
+            continue;
+        };
+        let mut domain_wide = false;
+        let mut deleted = value.is_empty();
+        for (key, v) in attrs {
+            if key.eq_ignore_ascii_case("domain") {
+                domain_wide = v.trim_start_matches('.').eq_ignore_ascii_case("youtube.com");
+            } else if key.eq_ignore_ascii_case("max-age") {
+                deleted |= v.parse::<i64>().is_ok_and(|s| s <= 0);
+            } else if key.eq_ignore_ascii_case("expires") {
+                // Google deletes with a date in 1970, so the year is enough.
+                deleted |= v
+                    .split(|c: char| !c.is_ascii_digit())
+                    .find(|t| t.len() == 4)
+                    .and_then(|y| y.parse::<i32>().ok())
+                    .is_some_and(|y| y < this_year);
+            }
+        }
+        if name.is_empty() || !domain_wide || deleted {
+            continue;
+        }
+        let mut found = false;
+        for (_, v) in jar.iter_mut().filter(|(n, _)| *n == name) {
+            found = true;
+            changed |= *v != value;
+            *v = value;
+        }
+        if !found {
+            jar.push((name, value));
+            changed = true;
+        }
+    }
+    changed.then(|| {
+        jar.iter()
+            .map(|(n, v)| format!("{n}={v}"))
+            .collect::<Vec<_>>()
+            .join("; ")
+    })
+}
