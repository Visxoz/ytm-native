+    fn take_response_cookies(&self, request: &Request, response: &Response) {
+        let set_cookie = response.headers().get_all(header::SET_COOKIE);
+        if set_cookie.iter().next().is_none() {
+            return;
+        }
+        if let Some(sent) = request.headers().get(header::COOKIE) {
+            let sent = sent.to_str().unwrap_or_default();
+            self.user_auth_take_cookies(sent, set_cookie.iter().filter_map(|v| v.to_str().ok()));
+        }
+    }
