+        assert!(status(403, "").should_retry());
+        assert!(status(403, "Request refused").is_stray_refusal());
+        let denied = status(403, "The caller does not have permission");
+        assert!(!denied.should_retry() && !denied.is_stray_refusal());
+        assert!(!status(404, "").is_stray_refusal());
+        assert!(status(503, "").should_retry());
+    }
