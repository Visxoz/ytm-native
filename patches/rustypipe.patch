+    /// Take in the `Set-Cookie` values of a response to a request that sent the
+    /// cookie `sent`, as a browser does, so the stored session keeps up with Google
+    /// rotating it. Answers for another login are left out. Kept in memory until
+    /// the cache is next stored.
+    pub fn user_auth_take_cookies<'a>(
+        &self,
+        sent: &str,
+        set_cookie: impl IntoIterator<Item = &'a str>,
+    ) -> bool {
+        let Some(login) = cookie_login(sent) else {
+            return false;
+        };
+        let mut stored = self.inner.cache.auth_cookie.write().unwrap();
+        let Some(auth) = stored.as_mut().filter(|a| cookie_login(&a.cookie) == Some(login)) else {
+            return false;
+        };
+        match merge_set_cookies(&auth.cookie, set_cookie) {
+            Some(cookie) => {
+                auth.cookie = cookie;
+                true
+            }
+            None => false,
+        }
+    }
