+    /// Waits out a pause in signed-in requests, returning whether there was one.
+    async fn wait_for_turn(&self) -> bool {
+        let until = self.inner.refusals.lock().unwrap().paused_until;
+        let wait = until.map_or(Duration::ZERO, |u| {
+            u.saturating_duration_since(Instant::now())
+        });
+        if wait.is_zero() {
+            return false;
+        }
+        tokio::time::sleep(wait).await;
+        true
+    }
+
+    /// Counts a signed-in request YouTube answered, `refused` or otherwise.
+    fn signed_in_answered(&self, refused: bool) {
+        let mut refusals = self.inner.refusals.lock().unwrap();
+        refusals.run = if refused {
+            refusals.run.saturating_add(1)
+        } else {
+            0
+        };
+        let Some(pause) = refusal_pause(refusals.run) else {
+            return;
+        };
+        let until = Instant::now() + pause;
+        if refusals.paused_until.is_none_or(|u| u < until) {
+            tracing::warn!("YouTube keeps refusing signed-in requests; pausing them for {pause:?}");
+            refusals.paused_until = Some(until);
+        }
+    }
