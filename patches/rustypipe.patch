 pub(crate) struct Header {
-    #[serde(alias = "musicResponsiveHeaderRenderer")]
     pub music_detail_header_renderer: HeaderRenderer,
 }
 
+/// Playlists owned by the signed-in user wrap their header in an editable one
+#[derive(Debug, Deserialize)]
+#[serde(untagged)]
+enum HeaderWrap {
+    #[serde(rename_all = "camelCase")]
+    Plain {
+        #[serde(alias = "musicResponsiveHeaderRenderer")]
+        music_detail_header_renderer: HeaderRenderer,
+    },
+    #[serde(rename_all = "camelCase")]
+    Editable {
+        music_editable_playlist_detail_header_renderer: EditableHeader,
+    },
+}
+
+#[derive(Debug, Deserialize)]
+struct EditableHeader {
+    header: Box<HeaderWrap>,
+}
+
+impl From<HeaderWrap> for Header {
+    fn from(wrap: HeaderWrap) -> Self {
+        match wrap {
+            HeaderWrap::Plain {
+                music_detail_header_renderer,
+            } => Self {
+                music_detail_header_renderer,
+            },
+            HeaderWrap::Editable {
+                music_editable_playlist_detail_header_renderer,
+            } => (*music_editable_playlist_detail_header_renderer.header).into(),
+        }
+    }
+}
+
 #[serde_as]
 #[derive(Debug, Deserialize)]
 #[serde(rename_all = "camelCase")]
