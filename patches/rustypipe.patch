+    #[test]
+    fn pauses_only_after_a_run_of_refusals() {
+        assert_eq!(refusal_pause(REFUSAL_RUN - 1), None, "stray ones only retry");
+        assert_eq!(refusal_pause(REFUSAL_RUN), Some(Duration::from_secs(5)));
+        assert_eq!(refusal_pause(REFUSAL_RUN + 1), Some(Duration::from_secs(10)));
