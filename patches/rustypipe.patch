+/// A copy of a failed fetch's error for the requests that waited on it, as
+/// [`Error`] is not `Clone`. A fetch fails with one of these variants;
+/// anything else is carried as its message.
+fn shared_failure(e: &Error) -> Error {
+    match e {
+        Error::Http(msg) => Error::Http(msg.clone()),
+        Error::HttpStatus(status, msg) => Error::HttpStatus(*status, msg.clone()),
+        Error::Extraction(ExtractionError::InvalidData(msg)) => {
+            Error::Extraction(ExtractionError::InvalidData(msg.clone()))
+        }
+        Error::Other(msg) => Error::Other(msg.clone()),
+        e => Error::Other(e.to_string().into()),
+    }
+}
