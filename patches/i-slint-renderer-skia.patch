+/// What wgpu's shader-visible descriptor heap needs to hold. Skia draws through
+/// its own D3D12 heaps, and wgpu itself only clears and transitions the frame,
+/// binding nothing.
+const NON_SAMPLER_BINDINGS: u32 = 4096;
+
+/// `init_instance_adapter_device_queue_surface` for no requested API, but with
+/// the device asking for few bindings. Given the adapter's own limits, as there,
+/// wgpu makes a descriptor heap of a million entries on D3D12, about 30 MB of
+/// the process's memory that nothing uses.
+fn init_with_few_bindings(
+    target: Box<dyn wgpu::DisplayAndWindowHandle + 'static>,
+) -> Result<
+    (wgpu::Instance, wgpu::Adapter, wgpu::Device, wgpu::Queue, wgpu::Surface<'static>),
+    PlatformError,
+> {
+    use i_slint_core::graphics::wgpu_30 as slint_wgpu;
+    // Resolve on the first poll on native platforms.
+    let ready = |what: &str| PlatformError::from(format!("WGPU {what} was not ready"));
+    let backends = slint_wgpu::mask_backends(
+        wgpu::Backends::from_env().unwrap_or_default(),
+        slint_wgpu::default_backends_to_avoid(),
+    );
+    if backends.is_empty() {
+        return Err("No graphics API is supported under wgpu on this platform".into());
+    }
+    let instance = slint_wgpu::poll_once(wgpu::util::new_instance_with_webgpu_detection(
+        wgpu::InstanceDescriptor {
+            backends,
+            flags: wgpu::InstanceFlags::from_build_config().with_env(),
+            backend_options: slint_wgpu::default_backend_options(),
+            memory_budget_thresholds: wgpu::MemoryBudgetThresholds::default(),
+            display: None,
+        },
+    ))
+    .ok_or_else(|| ready("instance"))?;
+    let surface = instance
+        .create_surface(target)
+        .map_err(|e| format!("Error creating wgpu window surface: {e}"))?;
+    let adapter = slint_wgpu::poll_once(wgpu::util::initialize_adapter_from_env_or_default(
+        &instance,
+        Some(&surface),
+    ))
+    .ok_or_else(|| ready("adapter"))?
+    .map_err(|e| format!("Failed to find an appropriate adapter: {e}"))?;
+    let mut limits = adapter.limits();
+    limits.max_non_sampler_bindings = limits.max_non_sampler_bindings.min(NON_SAMPLER_BINDINGS);
+    let (device, queue) = slint_wgpu::poll_once(adapter.request_device(&wgpu::DeviceDescriptor {
+        label: None,
+        required_features: adapter.features() - wgpu::Features::all_experimental_mask(),
+        required_limits: limits,
+        experimental_features: wgpu::ExperimentalFeatures::disabled(),
+        memory_hints: wgpu::MemoryHints::MemoryUsage,
+        trace: wgpu::Trace::default(),
+    }))
+    .ok_or_else(|| ready("device"))?
+    .map_err(|e| format!("Failed to create device: {e}"))?;
+    Ok((instance, adapter, device, queue, surface))
+}
