diff --git a/sharedfontique.rs b/sharedfontique.rs
index fb03530..831d123 100644
--- a/sharedfontique.rs
+++ b/sharedfontique.rs
@@ -60,8 +60,13 @@ pub fn create_collection(shared: bool) -> Collection {
             if !registered_paths.insert(path.clone()) {
                 return;
             }
-            let Ok(bytes) = std::fs::read(&path) else { return };
-            let fonts = collection.register_fonts(bytes.into(), None);
+            // Patched for ytm-native: memory-mapped, as fontique maps system
+            // fonts, instead of read whole into the heap. Fallback fonts such
+            // as Segoe UI Emoji are many megabytes, of which few pages are used.
+            let Ok(file) = std::fs::File::open(&path) else { return };
+            // SAFETY: fonts are not modified while mapped, as with fontique's own.
+            let Ok(mapped) = (unsafe { memmap2::Mmap::map(&file) }) else { return };
+            let fonts = collection.register_fonts(fontique::Blob::new(Arc::new(mapped)), None);
             if fonts.is_empty() {
                 return;
             }
