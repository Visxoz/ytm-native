import { Theme, Icons } from "theme.slint";
import {
    Icon,
    IconButton,
    PlayButton,
    PillButton,
    Art,
    Equalizer,
} from "widgets.slint";
import { Api, TrackItem, CardItem, RowItem, RowKind } from "types.slint";

export global Layout {
    out property <length> card-width: 188px;
    out property <length> card-padding: 12px;
    out property <length> card-text: 52px;
    out property <length> card-gap: 4px;
    out property <length> chip-min-width: 190px;
    out property <length> chip-height: 96px;
    out property <length> chip-gap: 16px;
    out property <length> header-height: 300px;
    out property <length> banner-height: 340px;
    out property <length> actions-height: 96px;
    out property <length> top-height: 236px;

    // Card height for a given card width.
    public pure function card-height(width: length) -> length {
        return width - 2 * self.card-padding + self.card-text + 2 * self.card-padding;
    }
}

component Link inherits Text {
    in property <bool> enabled: true;
    callback clicked();
    overflow: elide;
    color: touch.has-hover && root.enabled ? Theme.text : Theme.text-secondary;
    font-size: 13px;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component TrackRow inherits Rectangle {
    in property <TrackItem> track;
    in property <bool> numbered;
    in property <bool> show-album;
    in property <int> section;
    in property <int> index;
    property <bool> playing: root.track.id != "" && Api.playing-id == root.track.id;
    property <bool> hot: touch.has-hover || more.has-hover;
    height: 56px;
    border-radius: 6px;
    background: root.hot ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }

    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "Play next";
                activated => { Api.track-action("next", root.section, root.index); }
            }

            MenuItem {
                title: "Add to queue";
                activated => { Api.track-action("queue", root.section, root.index); }
            }

            MenuItem {
                title: "Start radio";
                activated => { Api.track-action("radio", root.section, root.index); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Go to artist";
                enabled: root.track.has-artist;
                activated => { Api.track-action("artist", root.section, root.index); }
            }

            MenuItem {
                title: "Go to album";
                enabled: root.track.has-album;
                activated => { Api.track-action("album", root.section, root.index); }
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { Api.play-track(root.section, root.index); }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 16px;

            // Number, or play / equaliser
            Rectangle {
                width: 24px;
                if root.playing && !root.hot: Equalizer {
                    active: Api.is-playing;
                }
                // No touch area of its own: one would steal the row's hover and
                // make the row flicker between states. The row click plays.
                if root.hot: Icon {
                    path: root.playing && Api.is-playing ? Icons.pause : Icons.play;
                    size: 18px;
                }
                if !root.playing && !root.hot: Text {
                    text: root.track.number;
                    font-size: 15px;
                    color: Theme.text-secondary;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                horizontal-stretch: 3;
                // Zero preferred width so columns split by stretch alone and line up.
                preferred-width: 0px;
                min-width: 0px;
                if !root.numbered: Art {
                    y: (parent.height - self.height) / 2;
                    width: 40px;
                    height: 40px;
                    source: root.track.art;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.track.title;
                        overflow: elide;
                        font-size: 15px;
                        font-weight: 500;
                        color: root.playing ? Theme.accent : Theme.text;
                    }
                    // Only the text is a link, so the rest of the row still plays.
                    HorizontalLayout {
                        alignment: start;
                        Link {
                            max-width: self.preferred-width;
                            text: root.track.artists;
                            enabled: root.track.has-artist;
                            clicked => { Api.track-action("artist", root.section, root.index); }
                        }
                    }
                }
            }

            if root.show-album: HorizontalLayout {
                horizontal-stretch: 2;
                preferred-width: 0px;
                min-width: 0px;
                alignment: start;
                Link {
                    vertical-alignment: center;
                    max-width: self.preferred-width;
                    text: root.track.album;
                    font-size: 14px;
                    enabled: root.track.has-album;
                    clicked => { Api.track-action("album", root.section, root.index); }
                }
            }

            more := Rectangle {
                width: 32px;
                property <bool> has-hover: more-touch.has-hover;
                opacity: root.hot ? 1 : 0;
                animate opacity { duration: Theme.fast; }
                Icon {
                    path: Icons.more;
                    size: 20px;
                    color: more-touch.has-hover ? Theme.text : Theme.text-secondary;
                }

                more-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { menu.show({ x: more.x, y: more.y + more.height - 8px }); }
                }
            }

            Text {
                width: 44px;
                text: root.track.duration;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
                font-size: 14px;
            }
        }
    }
}

/// The column labels above a track list.
component Columns {
    in property <bool> show-album;
    height: 44px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        Text {
            width: 24px;
            text: "#";
            font-size: 14px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 3;
            preferred-width: 0px;
            min-width: 0px;
            text: "Title";
            font-size: 14px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }

        if root.show-album: Text {
            horizontal-stretch: 2;
            preferred-width: 0px;
            min-width: 0px;
            text: "Album";
            font-size: 14px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        Rectangle {
            width: 32px;
        }

        Rectangle {
            width: 44px;
            Icon {
                x: parent.width - self.width;
                path: Icons.clock;
                size: 16px;
                color: Theme.text-secondary;
            }
        }
    }

    Rectangle {
        y: parent.height - 9px;
        height: 1px;
        background: Theme.divider;
    }
}

export component Card {
    in property <CardItem> card;
    /// The pointer dragged sideways by `dx` since it pressed, for a carousel
    /// to scroll by; a release after a drag is not a click.
    callback dragged(dx: length);
    callback drag-ended();
    width: Layout.card-width;
    height: Layout.card-height(self.width);
    property <length> art-size: root.width - 2 * Layout.card-padding;
    property <bool> hot: touch.has-hover || play-button.has-hover;

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Play";
                activated => { Api.play-card(root.card.kind, root.card.id); }
            }

            MenuItem {
                title: "Start radio";
                activated => { Api.card-radio(root.card.kind, root.card.id); }
            }
        }

        Rectangle {
            border-radius: 8px;
            background: root.hot ? Theme.elevated : transparent;
            animate background { duration: Theme.normal; }
        }

        touch := TouchArea {
            property <length> pressed-at;
            property <bool> dragging;
            mouse-cursor: self.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
            pointer-event(ev) => {
                if ev.button != PointerEventButton.left {
                    return;
                }
                if ev.kind == PointerEventKind.down {
                    self.pressed-at = self.mouse-x;
                } else if self.dragging {
                    self.dragging = false;
                    root.drag-ended();
                } else if ev.kind == PointerEventKind.up {
                    Api.navigate(root.card.kind, root.card.id, root.card.title);
                }
            }
            moved => {
                if self.pressed && (self.dragging || abs(self.mouse-x - self.pressed-at) > 6px) {
                    self.dragging = true;
                    root.dragged(self.mouse-x - self.pressed-at);
                }
            }
        }

        Art {
            x: Layout.card-padding;
            y: Layout.card-padding;
            width: root.art-size;
            height: root.art-size;
            source: root.card.art;
            round: root.card.round;
            radius: 6px;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000060;
        }

        Rectangle {
            x: Layout.card-padding + root.art-size - self.width - 8px;
            y: Layout.card-padding + root.art-size - self.height - (root.hot ? 8px : 0px);
            width: 48px;
            height: 48px;
            opacity: root.hot ? 1 : 0;
            animate y, opacity {
                duration: Theme.normal;
                easing: ease-out;
            }
            play-button := PlayButton {
                size: 48px;
                clicked => { Api.play-card(root.card.kind, root.card.id); }
            }
        }

        VerticalLayout {
            x: Layout.card-padding;
            y: Layout.card-padding + root.art-size + 8px;
            width: root.art-size;
            height: Layout.card-text - 4px;
            spacing: 4px;
            alignment: start;
            Text {
                text: root.card.title;
                overflow: elide;
                font-size: 15px;
                font-weight: 600;
                color: Theme.text;
            }

            Text {
                text: root.card.subtitle;
                overflow: elide;
                font-size: 13px;
                color: Theme.text-secondary;
            }
        }
    }
}

/// A large colour tile, as in Spotify's "Browse all".
component GenreTile inherits Rectangle {
    in property <CardItem> card;
    height: Layout.chip-height;
    border-radius: 8px;
    clip: true;
    background: @linear-gradient(135deg, root.card.tint 0%, root.card.tint.darker(0.45) 100%);
    Text {
        x: 16px;
        y: 14px;
        width: parent.width - 32px;
        text: root.card.title;
        wrap: word-wrap;
        font-size: 20px;
        font-weight: 700;
        font-family: Theme.display-font;
        color: Theme.text;
    }

    Rectangle {
        x: parent.width - 52px;
        y: parent.height - 44px;
        width: 64px;
        height: 64px;
        border-radius: 8px;
        background: #ffffff22;
        transform-rotation: 25deg;
    }

    Rectangle {
        background: touch.has-hover ? #ffffff14 : transparent;
        animate background { duration: Theme.fast; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Api.navigate(root.card.kind, root.card.id, root.card.title); }
    }
}

/// A row of cards scrolled with arrow buttons that appear on hover, or by
/// dragging the cards themselves.
export component Carousel {
    in property <[CardItem]> cards;
    property <length> step: Layout.card-width + Layout.card-gap;
    property <length> content-width: root.cards.length * root.step - Layout.card-gap;
    property <length> max-offset: max(0px, root.content-width - root.width);
    property <length> offset;
    property <bool> dragging;
    /// The offset as the drag began, which the pointer's movement is added to.
    property <length> drag-from;
    height: Layout.card-height(Layout.card-width);

    Rectangle {
        x: -Layout.card-padding;
        width: root.width + 2 * Layout.card-padding;
        clip: true;
        Rectangle {
            x: -root.offset;
            // The arrows glide; a drag follows the pointer at once.
            animate x {
                duration: root.dragging ? 0ms : 400ms;
                easing: ease-in-out;
            }
            for card[i] in root.cards: Card {
                x: i * root.step;
                y: 0;
                card: card;
                dragged(dx) => {
                    if !root.dragging {
                        root.dragging = true;
                        root.drag-from = root.offset;
                    }
                    root.offset = clamp(root.drag-from - dx, 0px, root.max-offset);
                }
                drag-ended => { root.dragging = false; }
            }
        }
    }

    if root.offset > 0: IconButton {
        x: -14px;
        y: (Layout.card-width - Layout.card-padding) / 2 - self.height / 2;
        icon: Icons.back;
        size: 36px;
        icon-size: 22px;
        color: Theme.text;
        background: #000000b0;
        hover-background: #000000e0;
        clicked => { root.offset = max(0px, root.offset - max(1, floor(root.width / root.step)) * root.step); }
    }
    if root.offset < root.max-offset: IconButton {
        x: root.width - self.width + 14px;
        y: (Layout.card-width - Layout.card-padding) / 2 - self.height / 2;
        icon: Icons.forward;
        size: 36px;
        icon-size: 22px;
        color: Theme.text;
        background: #000000b0;
        hover-background: #000000e0;
        clicked => { root.offset = min(root.max-offset, root.offset + max(1, floor(root.width / root.step)) * root.step); }
    }
}

export component CardGrid {
    in property <[CardItem]> cards;
    out property <int> columns: max(1, floor((root.width + Layout.card-gap) / (Layout.card-width + Layout.card-gap)));
    property <length> cell: (root.width + 2 * Layout.card-padding - (root.columns - 1) * Layout.card-gap) / root.columns;
    for card[i] in root.cards: Card {
        x: -Layout.card-padding + mod(i, root.columns) * (root.cell + Layout.card-gap);
        y: floor(i / root.columns) * (Layout.card-height(root.cell) + Layout.card-gap);
        width: root.cell;
        card: card;
    }
}

export component GenreGrid {
    in property <[CardItem]> cards;
    property <int> columns: max(1, floor((root.width + Layout.chip-gap) / (Layout.chip-min-width + Layout.chip-gap)));
    property <length> cell: (root.width - (root.columns - 1) * Layout.chip-gap) / root.columns;
    for card[i] in root.cards: GenreTile {
        x: mod(i, root.columns) * (root.cell + Layout.chip-gap);
        y: floor(i / root.columns) * (Layout.chip-height + Layout.chip-gap);
        width: root.cell;
        card: card;
    }
}

/// The best search match, shown large.
component TopResult inherits Rectangle {
    in property <CardItem> card;
    property <bool> hot: touch.has-hover || top-play.has-hover;
    height: Layout.top-height - 36px;
    border-radius: 8px;
    background: root.hot ? Theme.highlight : #181818;
    animate background { duration: Theme.normal; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Api.navigate(root.card.kind, root.card.id, root.card.title); }
    }

    Art {
        x: 20px;
        y: 20px;
        width: 96px;
        height: 96px;
        source: root.card.art;
        round: root.card.round;
        radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
    }

    Text {
        x: 20px;
        y: 132px;
        width: parent.width - 120px;
        text: root.card.title;
        overflow: elide;
        font-size: 30px;
        font-weight: 700;
        font-family: Theme.display-font;
        color: Theme.text;
    }

    Text {
        x: 20px;
        y: 172px;
        width: parent.width - 120px;
        text: root.card.subtitle;
        overflow: elide;
        font-size: 14px;
        color: Theme.text-secondary;
    }

    Rectangle {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - (root.hot ? 20px : 12px);
        width: 52px;
        height: 52px;
        opacity: root.hot ? 1 : 0;
        animate y, opacity {
            duration: Theme.normal;
            easing: ease-out;
        }
        top-play := PlayButton {
            size: 52px;
            clicked => { Api.play-card(root.card.kind, root.card.id); }
        }
    }
}

/// Album, playlist, artist and genre headers with their action buttons.
export component PageHeader {
    in property <RowItem> data;
    in property <length> full-width;
    property <bool> has-art: root.data.art.width > 0 || root.data.can-play;
    property <length> art-height: root.data.banner ? Layout.banner-height : root.has-art ? Layout.header-height : 160px;
    property <length> title-size: root.data.title.character-count <= 12 ? 76px : root.data.title.character-count <= 18 ? 60px : root.data.title.character-count <= 28 ? 44px : 34px;

    if root.data.banner: Rectangle {
        x: -Theme.page-padding;
        y: 0;
        width: root.full-width;
        height: root.art-height;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.data.art;
            image-fit: cover;
            opacity: root.data.art.width > 0 ? 1 : 0;
            animate opacity { duration: 400ms; }
        }

        Rectangle {
            background: @linear-gradient(180deg, #00000000 35%, #000000b0 100%);
        }
    }

    HorizontalLayout {
        y: 0;
        height: root.art-height;
        padding-bottom: 24px;
        spacing: 24px;
        alignment: start;
        if root.has-art && !root.data.banner: Art {
            y: parent.height - self.height - 24px;
            width: 232px;
            height: 232px;
            source: root.data.art;
            round: root.data.round;
            radius: 6px;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000090;
        }
        VerticalLayout {
            alignment: end;
            spacing: 6px;
            Text {
                text: root.data.label;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
            }

            Text {
                text: root.data.title;
                font-size: root.title-size;
                font-weight: 800;
                font-family: Theme.display-font;
                letter-spacing: -1px;
                color: Theme.text;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 0;
                alignment: start;
                if root.data.subtitle != "": Text {
                    text: root.data.subtitle;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                }
                if root.data.subtitle != "" && root.data.meta != "": Text {
                    text: "  •  ";
                    font-size: 14px;
                    color: Theme.text;
                }
                if root.data.meta != "": Text {
                    text: root.data.meta;
                    font-size: 14px;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
            }
        }
    }

    if root.data.can-play || root.data.can-radio: HorizontalLayout {
        y: root.art-height;
        height: Layout.actions-height;
        spacing: 20px;
        alignment: start;
        if root.data.can-play: PlayButton {
            y: (parent.height - self.height) / 2;
            size: 56px;
            clicked => { Api.header-action("play"); }
        }
        if root.data.can-shuffle: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.shuffle;
            size: 48px;
            icon-size: 30px;
            clicked => { Api.header-action("shuffle"); }
        }
        if root.data.can-radio: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.radio;
            size: 48px;
            icon-size: 28px;
            clicked => { Api.header-action("radio"); }
        }
    }
}

/// The height a row needs at a given content width.
export global Rows {
    public pure function height(row: RowItem, inner: length) -> length {
        if row.kind == RowKind.greeting {
            return 76px;
        }
        if row.kind == RowKind.header {
            let has-art = row.art.width > 0 || row.can-play;
            let base = row.banner ? Layout.banner-height : has-art ? Layout.header-height : 160px;
            return base + (row.can-play || row.can-radio ? Layout.actions-height : 8px);
        }
        if row.kind == RowKind.title {
            return 68px;
        }
        if row.kind == RowKind.columns {
            return 52px;
        }
        if row.kind == RowKind.track {
            return 56px;
        }
        if row.kind == RowKind.carousel {
            return Layout.card-height(Layout.card-width) + 8px;
        }
        if row.kind == RowKind.top {
            return Layout.top-height;
        }
        if row.kind == RowKind.grid {
            let columns = max(1, floor((inner + Layout.card-gap) / (Layout.card-width + Layout.card-gap)));
            let cell = (inner + 2 * Layout.card-padding - (columns - 1) * Layout.card-gap) / columns;
            return ceil(row.cards.length / columns) * (Layout.card-height(cell) + Layout.card-gap);
        }
        let columns = max(1, floor((inner + Layout.chip-gap) / (Layout.chip-min-width + Layout.chip-gap)));
        return ceil(row.cards.length / columns) * (Layout.chip-height + Layout.chip-gap);
    }
}

/// One entry of the page list; its kind picks what it shows.
export component PageRow {
    in property <RowItem> data;
    in property <length> content-width;
    property <length> inner: root.content-width - 2 * Theme.page-padding;
    width: root.content-width;
    height: Rows.height(root.data, root.inner);

    if root.data.kind == RowKind.greeting: Text {
        x: Theme.page-padding;
        y: 28px;
        text: root.data.title;
        font-size: 32px;
        font-weight: 800;
        font-family: Theme.display-font;
        color: Theme.text;
    }
    if root.data.kind == RowKind.header: PageHeader {
        x: Theme.page-padding;
        y: 0;
        width: root.inner;
        height: root.height;
        full-width: root.content-width;
        data: root.data;
    }
    if root.data.kind == RowKind.title: Text {
        x: Theme.page-padding;
        y: 28px;
        width: root.inner;
        text: root.data.title;
        font-size: 24px;
        font-weight: 800;
        font-family: Theme.display-font;
        color: Theme.text;
        overflow: elide;
    }
    if root.data.kind == RowKind.columns: Columns {
        x: Theme.page-padding;
        width: root.inner;
        show-album: root.data.show-album;
    }
    if root.data.kind == RowKind.track: TrackRow {
        x: Theme.page-padding;
        width: root.inner;
        track: root.data.track;
        numbered: root.data.numbered;
        show-album: root.data.show-album && root.inner > 640px;
        section: root.data.section;
        index: root.data.index;
    }
    if root.data.kind == RowKind.carousel: Carousel {
        x: Theme.page-padding;
        y: 0;
        width: root.inner;
        cards: root.data.cards;
    }
    if root.data.kind == RowKind.grid: CardGrid {
        x: Theme.page-padding;
        y: 0;
        width: root.inner;
        height: root.height;
        cards: root.data.cards;
    }
    if root.data.kind == RowKind.chips: GenreGrid {
        x: Theme.page-padding;
        y: 0;
        width: root.inner;
        height: root.height;
        cards: root.data.cards;
    }
    if root.data.kind == RowKind.top: TopResult {
        x: Theme.page-padding;
        y: 12px;
        width: min(root.inner, 520px);
        card: root.data.cards[0];
    }
}
