export global Theme {
    // Surfaces, from the window outwards.
    out property <color> background: #000000;
    out property <color> panel: #121212;
    out property <color> elevated: #1f1f1f;
    out property <color> highlight: #2a2a2a;
    out property <color> menu: #282828;
    out property <color> hover: #ffffff14;
    out property <color> pressed: #ffffff24;
    out property <color> divider: #ffffff1a;

    out property <color> text: #ffffff;
    out property <color> text-secondary: #b3b3b3;
    out property <color> text-dim: #7a7a7a;

    // YouTube Music's red.
    out property <color> accent: #ff0033;
    out property <color> accent-hover: #ff3358;
    out property <color> home-tint: #5c0f1c;

    out property <length> gap: 8px;
    out property <length> panel-radius: 8px;
    out property <length> page-padding: 24px;
    out property <length> sidebar-wide: 300px;
    out property <length> sidebar-narrow: 72px;
    out property <length> right-panel: 360px;
    out property <length> top-bar: 64px;
    out property <length> player-bar: 88px;

    out property <string> display-font: "Segoe UI Variable Display";
    out property <duration> fast: 120ms;
    out property <duration> normal: 220ms;
}

