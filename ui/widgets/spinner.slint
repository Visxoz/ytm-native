import { Theme } from "../theme.slint";
import { Api } from "../types.slint";

/// A Material-style spinner: an arc that grows and shrinks as it turns.
export component Spinner {
    in property <length> size: 32px;
    in property <color> color: Theme.accent;
    width: root.size;
    height: root.size;
    property <duration> t: animation-tick();
    // The arc sweeps between 30° and 270°, and the whole spinner turns.
    property <float> breath: 0.5 - 0.5 * cos(mod(root.t / 1400ms, 1) * 360deg);
    property <angle> sweep: 30deg + 240deg * root.breath;
    property <angle> spin: mod(root.t / 1100ms, 1) * 360deg + root.breath * 120deg;
    property <float> end-x: 12 + 10 * sin(root.sweep);
    property <float> end-y: 12 - 10 * cos(root.sweep);

    // Faint track on the same circle as the arc.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 2 A 10 10 0 1 1 11.99 2";
        stroke: #ffffff1f;
        stroke-width: root.size / 12;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 2 A 10 10 0 " + (root.sweep > 180deg ? "1" : "0") + " 1 " + root.end-x + " " + root.end-y;
        stroke: root.color;
        stroke-width: root.size / 12;
        stroke-line-cap: round;
        transform-rotation: root.spin;
    }
}

/// Three bouncing bars marking the playing track.
export component Equalizer {
    in property <bool> active;
    in property <color> color: Theme.accent;
    width: 16px;
    height: 14px;
    for i in 3: Rectangle {
        x: i * 5.5px;
        width: 3px;
        height: root.active ? root.height * (0.25 + 0.75 * abs(sin((Api.eq-phase * 0.55 + i * 0.37) * 180deg))) : root.height * 0.3;
        y: root.height - self.height;
        border-radius: 1px;
        background: root.color;
    }
}
