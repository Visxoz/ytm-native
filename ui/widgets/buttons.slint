import { Icons, Theme } from "../theme.slint";

export component Icon {
    in property <string> path;
    in property <color> color: Theme.text;
    in property <length> size: 24px;
    width: root.size;
    height: root.size;
    Path {
        width: 100%;
        height: 100%;
        commands: root.path;
        fill: root.color;
        viewbox-width: 24;
        viewbox-height: 24;
        animate fill { duration: Theme.fast; }
    }
}

/// A round icon button that shrinks slightly while pressed.
export component IconButton {
    in property <string> icon;
    in property <length> size: 32px;
    in property <length> icon-size: 18px;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <color> color: Theme.text-secondary;
    in property <color> background: transparent;
    in property <color> hover-background: Theme.hover;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    width: root.size;
    height: root.size;

    Rectangle {
        border-radius: self.height / 2;
        background: touch.has-hover && root.enabled ? root.hover-background : root.background;
        animate background { duration: Theme.fast; }
    }

    Icon {
        path: root.icon;
        size: root.icon-size;
        color: !root.enabled ? Theme.ink.with-alpha(0.25) : root.active ? Theme.accent : touch.has-hover ? Theme.text : root.color;
        transform-scale: touch.pressed ? 0.88 : 1.0;
        animate transform-scale { duration: 90ms; }
    }

    if root.active: Rectangle {
        y: root.height / 2 + root.icon-size / 2 + 2px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// The red circular play button.
export component PlayButton {
    in property <length> size: 56px;
    in property <bool> playing;
    in property <color> color: Theme.accent;
    in property <color> icon-color: Theme.on-colour;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    width: root.size;
    height: root.size;

    circle := Rectangle {
        border-radius: self.height / 2;
        background: touch.has-hover ? root.color.brighter(0.15) : root.color;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000080;
        transform-scale: touch.pressed ? 0.95 : touch.has-hover ? 1.05 : 1.0;
        animate transform-scale {
            duration: Theme.fast;
            easing: ease-out;
        }
        animate background { duration: Theme.fast; }
        Icon {
            path: root.playing ? Icons.pause : Icons.play;
            size: root.size * 0.48;
            color: root.icon-color;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PillButton {
    in property <string> text;
    in property <bool> primary;
    in property <bool> small;
    callback clicked();
    height: root.small ? 32px : 40px;
    min-width: label.preferred-width + (root.small ? 32px : 48px);

    Rectangle {
        border-radius: self.height / 2;
        background: root.primary ? Theme.text : transparent;
        border-width: root.primary ? 0 : 1px;
        border-color: touch.has-hover ? Theme.text : Theme.ink.with-alpha(0.44);
        transform-scale: touch.pressed ? 0.96 : touch.has-hover && root.primary ? 1.04 : 1.0;
        animate transform-scale { duration: Theme.fast; }
        animate border-color { duration: Theme.fast; }
    }

    label := Text {
        text: root.text;
        font-size: root.small ? 13px : 14px;
        font-weight: 700;
        color: root.primary ? Theme.text-inverse : Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 32px;
    width: text.preferred-width + 28px;
    border-radius: 16px;
    background: root.active ? Theme.text : touch.has-hover ? Theme.ink.with-alpha(0.15) : Theme.hover;
    animate background { duration: Theme.fast; }
    text := Text {
        text: root.label;
        font-size: 14px;
        font-weight: 600;
        color: root.active ? Theme.text-inverse : Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A row of pills, one of them picked.
export component PillGroup inherits HorizontalLayout {
    in property <[string]> labels;
    in property <int> current;
    callback picked(index: int);
    spacing: 6px;
    for label[i] in root.labels: Pill {
        label: label;
        active: root.current == i;
        clicked => { root.picked(i); }
    }
}
