export struct TrackItem {
    id: string,
    title: string,
    artists: string,
    album: string,
    duration: string,
    art: image,
    number: string,
    has-artist: bool,
    has-album: bool,
}

export struct CardItem {
    kind: string,
    id: string,
    title: string,
    subtitle: string,
    art: image,
    round: bool,
    tint: color,
}

export enum RowKind { greeting, header, title, columns, track, carousel, grid, chips, top }

/// One row of the virtualised page list.
export struct RowItem {
    kind: RowKind,
    // header, title and greeting
    label: string,
    title: string,
    subtitle: string,
    meta: string,
    art: image,
    round: bool,
    banner: bool,
    can-play: bool,
    can-shuffle: bool,
    can-radio: bool,
    // track rows and their column header
    track: TrackItem,
    numbered: bool,
    show-album: bool,
    // card rows
    cards: [CardItem],
    // where the row's items live in the page, for callbacks
    section: int,
    index: int,
}

export struct QueueItem {
    id: string,
    title: string,
    artists: string,
    duration: string,
    art: image,
    current: bool,
    /// Mixed in by Smart Shuffle.
    recommended: bool,
    /// Picked with Ctrl- or Shift-click.
    selected: bool,
}

/// An accent colour offered in Settings.
export struct AccentChoice {
    name: string,
    colour: color,
    /// Taken from the playing song's artwork rather than `colour`.
    artwork: bool,
}

/// One of the account's playlists, offered for saving a song to.
export struct PlaylistChoice {
    title: string,
    /// Already holds the song.
    contains: bool,
}

/// Calls from anywhere in the UI into Rust, and state many components read.
export global Api {
    callback navigate(kind: string, id: string, title: string);
    callback play-track(section: int, index: int);
    callback track-action(action: string, section: int, index: int);
    callback play-card(kind: string, id: string);
    callback card-radio(kind: string, id: string);
    callback header-action(action: string);
    /// Likes (1) or dislikes (2) a song, or takes that back if it had it;
    /// 0 removes either.
    callback rate(id: string, rating: int);
    callback save-to-playlist(id: string);
    in property <bool> signed-in;
    /// How the account rated the playing song: 0 none, 1 like, 2 dislike.
    in property <int> playing-rating;
    in-out property <string> playing-id;
    in-out property <bool> is-playing;
    /// Advanced a few times a second while playing; drives the equalisers
    /// without repainting every frame.
    in property <int> eq-phase;

    /// The rating known for `id`: only the playing song's is.
    public pure function rating-of(id: string) -> int {
        id == root.playing-id ? root.playing-rating : 0
    }
}
