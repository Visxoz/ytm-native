import { Icons, Theme } from "../theme.slint";
import { AccentChoice, Api } from "../types.slint";
import { IconButton, PillButton, PillGroup } from "../widgets/buttons.slint";
import { ListView } from "../widgets/list.slint";
import { MenuEntry, PopupMenu } from "../widgets/menu.slint";
import { Slider } from "../widgets/slider.slint";
import { Toggle } from "../widgets/toggle.slint";
import { Dialog, SettingRow, ToggleRow } from "dialog.slint";

component Swatch inherits Rectangle {
    in property <brush> fill;
    in property <bool> active;
    in property <string> name;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: self.height / 2;
    border-width: 2px;
    border-color: root.active ? Theme.text : touch.has-hover ? Theme.ink.with-alpha(0.3) : transparent;
    animate border-color { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: root.name;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: self.height / 2;
        background: root.fill;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A button opening a list of choices, ticking the one in use.
component ChoiceButton {
    in property <string> text;
    in property <[string]> choices;
    in property <int> current;
    in property <length> menu-width: 240px;
    callback opening();
    callback picked(index: int);
    width: button.min-width;

    button := PillButton {
        y: (parent.height - self.height) / 2;
        text: root.text;
        small: true;
        clicked => {
            root.opening();
            menu.show();
        }
    }

    menu := PopupMenu {
        width: root.menu-width;
        x: button.width - self.width;
        y: button.y + button.height + 4px;
        for name[i] in root.choices: MenuEntry {
            text: name;
            icon: i == root.current ? Icons.check : "";
            active: i == root.current;
            activated => { root.picked(i); }
        }
    }
}

/// A one-line box for an address, applied with Enter. `accepted` answers
/// why it wasn't taken, or nothing, so a mistyped one stays to be corrected.
component AddressField inherits Rectangle {
    in property <string> placeholder;
    in property <string> name;
    callback accepted(text: string) -> string;
    callback edited();
    width: 180px;
    height: 32px;
    border-radius: self.height / 2;
    background: input.has-focus || touch.has-hover ? Theme.control-hover : Theme.control;
    border-width: 1px;
    border-color: input.has-focus ? Theme.text : transparent;
    animate background, border-color { duration: Theme.fast; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    input := TextInput {
        x: 14px;
        width: parent.width - 28px;
        height: 100%;
        vertical-alignment: center;
        single-line: true;
        font-size: 13px;
        color: Theme.text;
        selection-background-color: Theme.accent.with-alpha(0.5);
        accessible-label: root.name;
        edited => { root.edited(); }
        accepted => {
            if root.accepted(self.text) == "" {
                self.text = "";
            }
        }
    }

    if input.text == "": Text {
        x: 14px;
        width: parent.width - 28px;
        height: 100%;
        overflow: elide;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.text-dim;
        font-size: 13px;
    }
}

/// One tab's rows, all tabs the same height so the dialog keeps its size
/// when switching between them.
component Tab inherits VerticalLayout {
    spacing: 18px;
    alignment: start;
    min-height: 400px;
}

export component SettingsDialog inherits Dialog {
    in-out property <bool> settings-open;
    in-out property <bool> eq-open;
    in-out property <bool> sign-in-open;
    in property <int> quality;
    in property <string> premium-status;
    in property <int> normalise;
    in property <bool> crossfade;
    in property <[string]> crossfade-lengths;
    in property <int> crossfade-secs;
    in property <[string]> output-devices;
    in property <int> output-device;
    in property <string> output-detail;
    in property <[string]> speeds;
    in property <int> speed;
    in property <bool> equaliser;
    in property <[string]> eq-presets;
    in property <int> eq-preset;
    in property <bool> crossfeed;
    in property <bool> mono;
    in property <float> balance;
    callback set-crossfeed(value: bool);
    callback set-mono(value: bool);
    callback set-balance(value: float, done: bool);
    in property <bool> autoplay;
    in property <bool> youtube-history;
    in property <bool> rating-buttons;
    in property <bool> discord;
    in property <string> update-status;
    in property <string> update-version;
    in property <bool> update-busy;
    in property <bool> check-updates;
    in property <[AccentChoice]> accents;
    in property <int> accent-choice;
    in property <bool> close-to-tray;
    in property <bool> lastfm-available;
    in property <string> lastfm-user;
    in property <bool> lastfm-connecting;
    in property <[string]> local-folders;
    in property <string> proxy-detail;
    /// The saved proxy without any password, or none.
    in property <string> proxy-address;
    callback set-quality(value: int);
    callback set-normalise(value: int);
    callback set-crossfade(value: bool);
    callback set-crossfade-secs(index: int);
    callback set-output-device(index: int);
    callback list-output-devices();
    callback set-speed(index: int);
    callback set-autoplay(value: bool);
    callback set-youtube-history(value: bool);
    callback set-rating-buttons(value: bool);
    callback set-discord(value: bool);
    callback set-check-updates(value: bool);
    callback set-look(index: int);
    callback set-accent(index: int);
    callback set-close-to-tray(value: bool);
    callback lastfm-connect();
    callback lastfm-disconnect();
    callback install-update();
    callback sign-out();
    callback add-folder();
    callback remove-folder(index: int);
    callback set-proxy(address: string) -> string;
    /// The address field going with its tab or the dialog, which would
    /// otherwise leave the window's keys with nothing focused.
    callback release-focus();
    property <int> tab;
    property <string> proxy-error;

    changed tab => {
        root.proxy-error = "";
        root.release-focus();
    }

    title: "Settings";
    // Wide enough for the six tabs on one line.
    dialog-width: 580px;
    open: root.settings-open;
    close => { root.settings-open = false; }
    PillGroup {
        labels: ["Playback", "Sound", "Library", "Appearance", "Account", "About"];
        current: root.tab;
        picked(i) => { root.tab = i; }
    }

    if root.tab == 0: Tab {
        SettingRow {
            label: "Audio quality";
            detail: root.quality == 0 ? "About 50 kbps, a third of the data of Normal. For a metered connection."
                : root.quality == 1 ? "About 130 kbps, as YouTube Music plays without Premium."
                : root.premium-status;
            PillGroup {
                y: (parent.height - self.height) / 2;
                height: self.preferred-height;
                labels: ["Low", "Normal", "High"];
                current: root.quality;
                picked(i) => { root.set-quality(i); }
            }
        }

        SettingRow {
            label: "Speed";
            detail: "Faster or slower, the pitch moving with it as on a record.";
            ChoiceButton {
                text: root.speed >= 0 ? root.speeds[root.speed] : "Custom";
                choices: root.speeds;
                current: root.speed;
                menu-width: 120px;
                picked(i) => { root.set-speed(i); }
            }
        }

        SettingRow {
            label: "Crossfade";
            detail: "Fades each track into the next. Tracks of an album played in order still run straight on.";
            if root.crossfade: ChoiceButton {
                text: root.crossfade-secs >= 0 ? root.crossfade-lengths[root.crossfade-secs] : "Custom";
                choices: root.crossfade-lengths;
                current: root.crossfade-secs;
                menu-width: 120px;
                picked(i) => { root.set-crossfade-secs(i); }
            }
            Toggle {
                y: (parent.height - self.height) / 2;
                checked: root.crossfade;
                toggled(v) => { root.set-crossfade(v); }
            }
        }

        ToggleRow {
            label: "Autoplay";
            detail: "Keeps playing similar music when the queue ends.";
            checked: root.autoplay;
            toggled(v) => { root.set-autoplay(v); }
        }
    }

    if root.tab == 1: Tab {
        SettingRow {
            label: "Output device";
            detail: root.output-detail;
            ChoiceButton {
                text: "Change";
                choices: root.output-devices;
                current: root.output-device;
                menu-width: 320px;
                // Listed again, as a device may have been plugged in since.
                opening => { root.list-output-devices(); }
                picked(i) => { root.set-output-device(i); }
            }
        }

        SettingRow {
            label: "Normalise volume";
            detail: root.normalise == 0 ? "Plays every track as it was mastered."
                : root.normalise == 1 ? "Plays every track at a similar loudness, a little quieter than Normal."
                : "Plays every track at a similar loudness, turning quiet ones up and loud ones down.";
            PillGroup {
                y: (parent.height - self.height) / 2;
                height: self.preferred-height;
                labels: ["Off", "Quiet", "Normal"];
                current: root.normalise;
                picked(i) => { root.set-normalise(i); }
            }
        }

        SettingRow {
            label: "Equaliser";
            detail: !root.equaliser ? "Off" : root.eq-preset >= 0 ? root.eq-presets[root.eq-preset] : "Custom";
            PillButton {
                y: (parent.height - self.height) / 2;
                text: "Adjust";
                small: true;
                clicked => {
                    root.settings-open = false;
                    root.eq-open = true;
                }
            }
        }

        ToggleRow {
            label: "Crossfeed";
            detail: "For headphones: blends a little of each side into the other, as speakers do.";
            checked: root.crossfeed;
            toggled(v) => { root.set-crossfeed(v); }
        }

        ToggleRow {
            label: "Mono";
            detail: "Both sides in each ear, for listening with one earbud.";
            checked: root.mono;
            toggled(v) => { root.set-mono(v); }
        }

        SettingRow {
            label: "Balance";
            detail: root.balance == 0 ? "Centre" : (root.balance < 0 ? "Left " : "Right ") + round(abs(root.balance) * 100) + "%";
            Slider {
                y: (parent.height - self.height) / 2;
                width: 160px;
                value: (root.balance + 1) / 2;
                accessible-role: slider;
                accessible-label: "Balance";
                accessible-value: parent.detail;
                changed(v) => { root.set-balance(v, false); }
                seek(v) => { root.set-balance(v, true); }
            }
        }
    }

    if root.tab == 2: Tab {
        SettingRow {
            label: "Local files";
            detail: root.local-folders.length == 0
                ? "Plays your own music from folders on this PC, under Local files."
                : "Plays your own music from these folders, under Local files.";
            PillButton {
                y: (parent.height - self.height) / 2;
                text: "Add folder";
                small: true;
                clicked => { root.add-folder(); }
            }
        }

        // Scrolls, so many folders can't push the dialog past the window.
        if root.local-folders.length > 0: folders := ListView {
            height: min(300px, root.local-folders.length * 40px);
            for folder[i] in root.local-folders: HorizontalLayout {
                width: folders.visible-width;
                height: 40px;
                // Clear of the scroll bar.
                padding-right: 14px;
                spacing: 8px;
                Text {
                    text: folder;
                    vertical-alignment: center;
                    overflow: elide;
                    font-size: 13px;
                    color: Theme.text-secondary;
                }
                IconButton {
                    icon: Icons.close;
                    icon-size: 16px;
                    clicked => { root.remove-folder(i); }
                }
            }
        }
    }

    if root.tab == 3: Tab {
        SettingRow {
            label: "Theme";
            PillGroup {
                y: (parent.height - self.height) / 2;
                height: self.preferred-height;
                labels: ["Dark", "Light", "Black"];
                current: Theme.look;
                picked(i) => { root.set-look(i); }
            }
        }

        SettingRow {
            label: "Accent colour";
            detail: root.accents[root.accent-choice].artwork ? "Follows the artwork of the song playing." : root.accents[root.accent-choice].name;
            HorizontalLayout {
                alignment: center;
                spacing: 2px;
                for accent[i] in root.accents: Swatch {
                    y: (parent.height - self.height) / 2;
                    name: accent.name;
                    fill: accent.artwork ? @linear-gradient(135deg, #ff0033 0%, #9b5cff 50%, #00a89d 100%) : accent.colour;
                    active: root.accent-choice == i;
                    clicked => { root.set-accent(i); }
                }
            }
        }

        ToggleRow {
            label: "Close to the system tray";
            detail: "Closing the window keeps the music playing, with Lily's icon in the system tray to bring it back or quit.";
            checked: root.close-to-tray;
            toggled(v) => { root.set-close-to-tray(v); }
        }
    }

    if root.tab == 4: Tab {
        SettingRow {
            label: Api.signed-in ? "Signed in" : "Not signed in";
            detail: Api.signed-in ? "Your library and history come from your YouTube account." : "Sign in to see your library and history.";
            PillButton {
                y: (parent.height - self.height) / 2;
                text: Api.signed-in ? "Sign out" : "Sign in";
                small: true;
                clicked => {
                    if Api.signed-in {
                        root.sign-out();
                    } else {
                        root.settings-open = false;
                        root.sign-in-open = true;
                    }
                }
            }
        }

        if Api.signed-in: ToggleRow {
            label: "YouTube history";
            detail: "Adds songs played here to your YouTube Music history, so your recommendations and Listen again reflect them.";
            checked: root.youtube-history;
            toggled(v) => { root.set-youtube-history(v); }
        }

        if Api.signed-in: ToggleRow {
            label: "Like and dislike buttons";
            detail: "Shows them beside the song playing. Liking adds a song to your Liked music; disliking steers your recommendations away from it.";
            checked: root.rating-buttons;
            toggled(v) => { root.set-rating-buttons(v); }
        }

        SettingRow {
            label: "Last.fm";
            detail: !root.lastfm-available ? "Not available in this build."
                : root.lastfm-connecting ? "Allow access on the Last.fm page in your browser."
                : root.lastfm-user != "" ? "Scrobbling what you play as " + root.lastfm-user + "."
                : "Logs what you play to your Last.fm profile.";
            if root.lastfm-available: PillButton {
                y: (parent.height - self.height) / 2;
                text: root.lastfm-connecting ? "Cancel" : root.lastfm-user != "" ? "Disconnect" : "Connect";
                small: true;
                clicked => {
                    if root.lastfm-connecting || root.lastfm-user != "" {
                        root.lastfm-disconnect();
                    } else {
                        root.lastfm-connect();
                    }
                }
            }
        }

        ToggleRow {
            label: "Discord Rich Presence";
            detail: "Shows what you are listening to on Discord.";
            checked: root.discord;
            toggled(v) => { root.set-discord(v); }
        }
    }

    if root.tab == 5: Tab {
        SettingRow {
            label: "Proxy";
            detail: root.proxy-error != "" ? root.proxy-error : root.proxy-detail;
            AddressField {
                y: (parent.height - self.height) / 2;
                placeholder: root.proxy-address != "" ? root.proxy-address : "http://host:port";
                name: "Proxy address";
                edited => { root.proxy-error = ""; }
                accepted(text) => {
                    root.proxy-error = root.set-proxy(text);
                    return root.proxy-error;
                }
            }
            if root.proxy-address != "": PillButton {
                y: (parent.height - self.height) / 2;
                text: "Clear";
                small: true;
                clicked => { root.proxy-error = root.set-proxy(""); }
            }
        }

        SettingRow {
            label: "Updates";
            detail: root.update-status;
            if root.update-version != "" && !root.update-busy: PillButton {
                y: (parent.height - self.height) / 2;
                text: "Update to " + root.update-version;
                primary: true;
                small: true;
                clicked => { root.install-update(); }
            }
            if root.update-version == "": Toggle {
                y: (parent.height - self.height) / 2;
                checked: root.check-updates;
                toggled(v) => { root.set-check-updates(v); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        Text {
            text: "Shortcuts: Space play/pause • Ctrl+K search • Ctrl+B sidebar • Ctrl+←/→ previous/next";
            font-size: 12px;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
    }
}
