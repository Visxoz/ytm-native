import { TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PillButton } from "../widgets/buttons.slint";
import { Spinner } from "../widgets/spinner.slint";
import { Dialog } from "dialog.slint";

/// Signs in through Google's own page, or with pasted cookies.
export component SignInDialog inherits Dialog {
    in property <bool> signing-in;
    in property <bool> signing-in-browser;
    in property <string> sign-in-error;
    in-out property <string> pasted-cookie;
    in-out property <bool> sign-in-open;
    callback sign-in(cookie: string);
    callback sign-in-browser();

    property <bool> pasting;
    title: "Sign in";
    dialog-width: 600px;
    open: root.sign-in-open;
    close => { root.sign-in-open = false; }
    Text {
        text: root.signing-in-browser
            ? "Finish signing in in the Google window. It closes by itself once you're signed in."
            : "Sign in with your Google account on Google's own page. Your password goes to Google only.";
        wrap: word-wrap;
        font-size: 13px;
        color: Theme.text-secondary;
    }

    if root.pasting: Text {
        text: "Or paste the cookies of a signed-in music.youtube.com session: either a cookies.txt export or the Cookie request header from the browser's developer tools (Network tab). Use a private window and close it afterwards, as YouTube rotates cookies of open sessions.";
        wrap: word-wrap;
        font-size: 13px;
        color: Theme.text-secondary;
    }
    if root.pasting: TextEdit {
        height: 160px;
        font-size: 12px;
        wrap: char-wrap;
        edited(text) => { root.pasted-cookie = text; }
    }
    if root.sign-in-error != "": Text {
        text: root.sign-in-error;
        wrap: word-wrap;
        font-size: 13px;
        color: Theme.light ? #c4002b : #ff6b81;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 12px;
        if root.signing-in || root.signing-in-browser: Spinner {
            size: 24px;
        }
        if !root.pasting: PillButton {
            text: "Paste cookies instead";
            clicked => { root.pasting = true; }
        }
        PillButton {
            text: "Cancel";
            clicked => { root.sign-in-open = false; }
        }

        if root.pasting: PillButton {
            text: "Sign in with cookies";
            clicked => { root.sign-in(root.pasted-cookie); }
        }
        PillButton {
            text: "Sign in with Google";
            primary: true;
            clicked => { root.sign-in-browser(); }
        }
    }
}
