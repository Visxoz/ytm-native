import { Theme } from "../theme.slint";
import { PillButton } from "../widgets/buttons.slint";
import { Slider } from "../widgets/slider.slint";
import { Toggle } from "../widgets/toggle.slint";
import { Dialog, SettingRow } from "dialog.slint";

/// The equaliser: a preset menu, the on/off switch, and a slider per band.
export component EqualiserDialog inherits Dialog {
    in-out property <bool> eq-open;
    in-out property <bool> equaliser;
    in property <[float]> eq-gains;
    in property <[string]> eq-bands;
    in property <[string]> eq-presets;
    /// The preset the gains match, or -1.
    in property <int> eq-preset;
    in property <float> eq-max-db;
    callback set-equaliser(on: bool);
    callback set-eq-preset(index: int);
    /// A band's slider, from 0 to 1, moved; `done` once it is let go.
    callback set-eq-band(band: int, value: float, done: bool);

    title: "Equaliser";
    open: root.eq-open;
    close => { root.eq-open = false; }
    SettingRow {
        label: "Preset";
        detail: "A starting point; the bands below fine-tune it.";
        preset-menu := ContextMenuArea {
            width: preset-button.preferred-width;
            Menu {
                for name[i] in root.eq-presets: MenuItem {
                    title: name;
                    activated => { root.set-eq-preset(i); }
                }
            }

            preset-button := PillButton {
                y: (parent.height - self.height) / 2;
                text: root.eq-preset >= 0 ? root.eq-presets[root.eq-preset] : "Custom";
                small: true;
                clicked => { preset-menu.show({ x: 0, y: self.y + self.height }); }
            }
        }

        // Two-way, as the toggle sets its own state when clicked.
        Toggle {
            y: (parent.height - self.height) / 2;
            checked <=> root.equaliser;
            toggled(v) => { root.set-equaliser(v); }
        }
    }

    for band[i] in root.eq-bands: HorizontalLayout {
        spacing: 16px;
        Text {
            width: 64px;
            text: band;
            vertical-alignment: center;
            font-size: 13px;
            color: Theme.text-secondary;
        }

        Slider {
            horizontal-stretch: 1;
            enabled: root.equaliser;
            value: (root.eq-gains[i] / root.eq-max-db + 1) / 2;
            changed(v) => { root.set-eq-band(i, v, false); }
            seek(v) => { root.set-eq-band(i, v, true); }
        }

        Text {
            width: 48px;
            text: (root.eq-gains[i] > 0 ? "+" : "") + round(root.eq-gains[i]) + " dB";
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: 13px;
            color: root.equaliser ? Theme.text : Theme.text-dim;
        }
    }
}
