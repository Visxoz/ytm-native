import { Icons, Theme } from "../theme.slint";
import { Api, CardItem, RowItem } from "../types.slint";
import { Art } from "../widgets/art.slint";
import { IconButton, PlayButton } from "../widgets/buttons.slint";
import { Layout } from "layout.slint";

/// The best search match, shown large.
export component TopResult inherits Rectangle {
    in property <CardItem> card;
    property <bool> hot: touch.has-hover || top-play.has-hover;
    height: Layout.top-height - 36px;
    border-radius: 8px;
    background: root.hot ? Theme.highlight : Theme.elevated;
    animate background { duration: Theme.normal; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Api.navigate(root.card.kind, root.card.id, root.card.title); }
    }

    Art {
        x: 20px;
        y: 20px;
        width: 96px;
        height: 96px;
        source: root.card.art;
        round: root.card.round;
        radius: 6px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
    }

    Text {
        x: 20px;
        y: 132px;
        width: parent.width - 120px;
        text: root.card.title;
        overflow: elide;
        font-size: 30px;
        font-weight: 700;
        font-family: Theme.display-font;
        color: Theme.text;
    }

    Text {
        x: 20px;
        y: 172px;
        width: parent.width - 120px;
        text: root.card.subtitle;
        overflow: elide;
        font-size: 14px;
        color: Theme.text-secondary;
    }

    Rectangle {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - (root.hot ? 20px : 12px);
        width: 52px;
        height: 52px;
        opacity: root.hot ? 1 : 0;
        animate y, opacity {
            duration: Theme.normal;
            easing: ease-out;
        }
        top-play := PlayButton {
            size: 52px;
            clicked => { Api.play-card(root.card.kind, root.card.id); }
        }
    }
}

/// Album, playlist, artist and genre headers with their action buttons.
export component PageHeader {
    in property <RowItem> data;
    in property <length> full-width;
    property <bool> has-art: root.data.art.width > 0 || root.data.can-play;
    property <length> art-height: Layout.header-art-height(root.data);
    property <length> title-size: root.data.title.character-count <= 12 ? 76px : root.data.title.character-count <= 18 ? 60px : root.data.title.character-count <= 28 ? 44px : 34px;
    // A banner is darkened behind its text, which stays white in every look.
    property <color> fg: root.data.banner ? Theme.on-colour : Theme.text;
    property <color> fg-secondary: root.data.banner ? Theme.on-colour.with-alpha(0.7) : Theme.text-secondary;

    if root.data.banner: Rectangle {
        x: -Theme.page-padding;
        y: 0;
        width: root.full-width;
        height: root.art-height;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.data.art;
            image-fit: cover;
            opacity: root.data.art.width > 0 ? 1 : 0;
            animate opacity { duration: 400ms; }
        }

        Rectangle {
            background: @linear-gradient(180deg, #00000000 35%, #000000b0 100%);
        }
    }

    HorizontalLayout {
        y: 0;
        height: root.art-height;
        padding-bottom: 24px;
        spacing: 24px;
        alignment: start;
        if root.has-art && !root.data.banner: Art {
            y: parent.height - self.height - 24px;
            width: 232px;
            height: 232px;
            source: root.data.art;
            round: root.data.round;
            radius: 6px;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000090;
        }
        VerticalLayout {
            alignment: end;
            spacing: 6px;
            Text {
                text: root.data.label;
                font-size: 14px;
                font-weight: 600;
                color: root.fg;
            }

            Text {
                text: root.data.title;
                font-size: root.title-size;
                font-weight: 800;
                font-family: Theme.display-font;
                letter-spacing: -1px;
                color: root.fg;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 0;
                alignment: start;
                if root.data.subtitle != "": Text {
                    text: root.data.subtitle;
                    font-size: 14px;
                    font-weight: 700;
                    color: root.fg;
                    overflow: elide;
                }
                if root.data.subtitle != "" && root.data.meta != "": Text {
                    text: "  •  ";
                    font-size: 14px;
                    color: root.fg;
                }
                if root.data.meta != "": Text {
                    text: root.data.meta;
                    font-size: 14px;
                    color: root.fg-secondary;
                    overflow: elide;
                }
            }
        }
    }

    if root.data.can-play || root.data.can-radio: HorizontalLayout {
        y: root.art-height;
        height: Layout.actions-height;
        spacing: 20px;
        alignment: start;
        if root.data.can-play: PlayButton {
            y: (parent.height - self.height) / 2;
            size: 56px;
            clicked => { Api.header-action("play"); }
        }
        if root.data.can-shuffle: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.shuffle;
            size: 48px;
            icon-size: 30px;
            clicked => { Api.header-action("shuffle"); }
        }
        if root.data.can-radio: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.radio;
            size: 48px;
            icon-size: 28px;
            clicked => { Api.header-action("radio"); }
        }
    }
}
