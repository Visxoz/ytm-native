import { Theme } from "../theme.slint";
import { Api, RowItem } from "../types.slint";
import { PageRow } from "../page/page-row.slint";
import { PillButton, PlayButton } from "../widgets/buttons.slint";
import { ListView } from "../widgets/list.slint";
import { PagePlaceholder } from "../widgets/skeleton.slint";

export component PageView inherits Rectangle {
    in property <[RowItem]> rows;
    in property <bool> page-loading;
    /// What the loading page looks like: see `PagePlaceholder`.
    in property <string> page-shape;
    in property <string> page-error;
    in property <string> page-title;
    in property <bool> page-can-play;
    /// The page's tint, or transparent for the theme's own.
    in property <color> accent;
    property <color> tint: root.accent.alpha == 0 ? Theme.home-tint : root.accent;
    in property <string> nav-current;
    in-out property <length> page-scroll;
    in-out property <bool> sign-in-open;

    callback go(nav: string);

    horizontal-stretch: 1;
    border-radius: Theme.panel-radius;
    background: Theme.panel;
    clip: true;

    Rectangle {
        y: root.page-scroll;
        height: 420px;
        background: @linear-gradient(180deg, Theme.tint(root.tint) 0%, Theme.panel 100%);
        animate background { duration: 500ms; }
    }

    // Beneath the page, and kept while the page fades in over it.
    if (root.page-loading || content.opacity < 1) && root.page-error == "": PagePlaceholder {
        shape: root.page-shape;
        loading: root.page-loading;
    }

    content := Rectangle {
        opacity: root.page-loading || root.page-error != "" ? 0 : 1;
        visible: self.opacity > 0;
        animate opacity { duration: 260ms; }
        list := ListView {
            width: 100%;
            height: 100%;
            content-y <=> root.page-scroll;
            for row[i] in root.rows: PageRow {
                data: row;
                index: i;
                content-width: list.visible-width;
            }
        }
    }

    // Sticky title once the header scrolls away.
    Rectangle {
        y: 0;
        height: 64px;
        background: Theme.tint(root.tint.darker(0.35));
        opacity: root.page-title != "" && -root.page-scroll > 280px && !root.page-loading ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.normal; }
        TouchArea { }

        HorizontalLayout {
            padding-left: Theme.page-padding;
            spacing: 12px;
            if root.page-can-play: PlayButton {
                y: (parent.height - self.height) / 2;
                size: 44px;
                clicked => { Api.header-action("play"); }
            }
            Text {
                text: root.page-title;
                vertical-alignment: center;
                font-size: 22px;
                font-weight: 800;
                font-family: Theme.display-font;
                color: Theme.text;
                overflow: elide;
            }
        }
    }

    if !root.page-loading && root.page-error != "": VerticalLayout {
        alignment: center;
        spacing: 20px;
        padding: 48px;
        Text {
            text: root.page-error;
            horizontal-alignment: center;
            font-size: 18px;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }

        // Downloads has nothing to try again.
        if root.nav-current != "downloads": HorizontalLayout {
            alignment: center;
            PillButton {
                text: root.nav-current == "local" ? "Add folder"
                    : root.nav-current == "library" && !Api.signed-in ? "Sign in" : "Try again";
                primary: true;
                clicked => {
                    if root.nav-current == "local" {
                        root.go("add-folder");
                    } else if root.nav-current == "library" && !Api.signed-in {
                        root.sign-in-open = true;
                    } else {
                        root.go("reload");
                    }
                }
            }
        }
    }
}
