import { Theme, Icons } from "theme.slint";
import { Api } from "types.slint";

export component Icon {
    in property <string> path;
    in property <color> color: Theme.text;
    in property <length> size: 24px;
    width: root.size;
    height: root.size;
    Path {
        width: 100%;
        height: 100%;
        commands: root.path;
        fill: root.color;
        viewbox-width: 24;
        viewbox-height: 24;
        animate fill { duration: Theme.fast; }
    }
}

/// A round icon button that shrinks slightly while pressed.
export component IconButton {
    in property <string> icon;
    in property <length> size: 36px;
    in property <length> icon-size: 20px;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> show-dot: root.active;
    in property <color> color: Theme.text-secondary;
    in property <color> background: transparent;
    in property <color> hover-background: Theme.hover;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    width: root.size;
    height: root.size;

    Rectangle {
        border-radius: self.height / 2;
        background: touch.has-hover && root.enabled ? root.hover-background : root.background;
        animate background { duration: Theme.fast; }
    }

    Icon {
        path: root.icon;
        size: root.icon-size;
        color: !root.enabled ? #ffffff40 : root.active ? Theme.accent : touch.has-hover ? Theme.text : root.color;
        transform-scale: touch.pressed ? 0.88 : 1.0;
        animate transform-scale { duration: 90ms; }
    }

    if root.show-dot: Rectangle {
        y: root.height / 2 + root.icon-size / 2 + 2px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// The red circular play button.
export component PlayButton {
    in property <length> size: 56px;
    in property <bool> playing;
    in property <color> color: Theme.accent;
    in property <color> icon-color: Theme.text;
    out property <bool> has-hover: touch.has-hover;
    callback clicked();
    width: root.size;
    height: root.size;

    circle := Rectangle {
        border-radius: self.height / 2;
        background: touch.has-hover ? root.color.brighter(0.15) : root.color;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000080;
        transform-scale: touch.pressed ? 0.95 : touch.has-hover ? 1.05 : 1.0;
        animate transform-scale {
            duration: Theme.fast;
            easing: ease-out;
        }
        animate background { duration: Theme.fast; }
        Icon {
            path: root.playing ? Icons.pause : Icons.play;
            size: root.size * 0.48;
            color: root.icon-color;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PillButton {
    in property <string> text;
    in property <bool> primary;
    in property <bool> small;
    callback clicked();
    height: root.small ? 32px : 40px;
    min-width: label.preferred-width + (root.small ? 32px : 48px);

    Rectangle {
        border-radius: self.height / 2;
        background: root.primary ? Theme.text : transparent;
        border-width: root.primary ? 0 : 1px;
        border-color: touch.has-hover ? Theme.text : #ffffff70;
        transform-scale: touch.pressed ? 0.96 : touch.has-hover && root.primary ? 1.04 : 1.0;
        animate transform-scale { duration: Theme.fast; }
        animate border-color { duration: Theme.fast; }
    }

    label := Text {
        text: root.text;
        font-size: root.small ? 13px : 14px;
        font-weight: 700;
        color: root.primary ? #000000 : Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Artwork with rounded corners that fades in once it has loaded.
export component Art inherits Rectangle {
    in property <image> source;
    in property <bool> round;
    in property <length> radius: 4px;
    border-radius: root.round ? min(self.width, self.height) / 2 : root.radius;
    clip: true;
    background: Theme.highlight;
    if root.source.width == 0: Icon {
        path: Icons.note;
        size: min(root.width, root.height) * 0.38;
        color: Theme.text-dim;
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
        opacity: root.source.width > 0 ? 1 : 0;
        animate opacity { duration: 300ms; }
    }
}

/// A rounded slider. `changed` fires while dragging, `seek` on release.
export component Slider {
    in property <float> value;
    in property <float> buffered;
    in property <bool> enabled: true;
    callback changed(float);
    callback seek(float);
    property <bool> dragging;
    property <float> drag-value;
    property <float> shown: root.dragging ? root.drag-value : clamp(root.value, 0, 1);
    property <bool> hot: (touch.has-hover || root.dragging) && root.enabled;
    height: 16px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff30;
        clip: true;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.buffered, 0, 1);
            background: #ffffff28;
        }

        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            border-radius: 2px;
            background: root.hot ? Theme.accent : Theme.text;
            animate background { duration: Theme.fast; }
        }
    }

    Rectangle {
        x: root.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000080;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: Theme.fast; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                root.dragging = true;
                root.drag-value = clamp(self.mouse-x / self.width, 0, 1);
                root.changed(root.drag-value);
            } else if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.seek(root.drag-value);
            }
        }
        moved => {
            if root.dragging {
                root.drag-value = clamp(self.mouse-x / self.width, 0, 1);
                root.changed(root.drag-value);
            }
        }
        scroll-event(ev) => {
            root.seek(clamp(root.value + (ev.delta-y > 0 ? 0.05 : -0.05), 0, 1));
            accept
        }
    }
}

/// An on/off switch in the accent colour.
export component Toggle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    Rectangle {
        border-radius: self.height / 2;
        background: root.checked ? Theme.accent : #ffffff38;
        animate background { duration: Theme.normal; }
    }

    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.text;
        animate x {
            duration: Theme.normal;
            easing: ease-in-out;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

/// A Material-style spinner: an arc that grows and shrinks as it turns.
export component Spinner {
    in property <length> size: 32px;
    in property <color> color: Theme.accent;
    width: root.size;
    height: root.size;
    property <duration> t: animation-tick();
    // The arc sweeps between 30° and 270°, and the whole spinner turns.
    property <float> breath: 0.5 - 0.5 * cos(mod(root.t / 1400ms, 1) * 360deg);
    property <angle> sweep: 30deg + 240deg * root.breath;
    property <angle> spin: mod(root.t / 1100ms, 1) * 360deg + root.breath * 120deg;
    property <float> end-x: 12 + 10 * sin(root.sweep);
    property <float> end-y: 12 - 10 * cos(root.sweep);

    // Faint track on the same circle as the arc.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 2 A 10 10 0 1 1 11.99 2";
        stroke: #ffffff1f;
        stroke-width: root.size / 12;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 2 A 10 10 0 " + (root.sweep > 180deg ? "1" : "0") + " 1 " + root.end-x + " " + root.end-y;
        stroke: root.color;
        stroke-width: root.size / 12;
        stroke-line-cap: round;
        transform-rotation: root.spin;
    }
}

/// Three bouncing bars marking the playing track.
export component Equalizer {
    in property <bool> active;
    in property <color> color: Theme.accent;
    width: 16px;
    height: 14px;
    for i in 3: Rectangle {
        x: i * 5.5px;
        width: 3px;
        height: root.active ? root.height * (0.25 + 0.75 * abs(sin((Api.eq-phase * 0.55 + i * 0.37) * 180deg))) : root.height * 0.3;
        y: root.height - self.height;
        border-radius: 1px;
        background: root.color;
    }
}
