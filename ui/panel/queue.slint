import { Icons, Theme } from "../theme.slint";
import { Api, QueueItem } from "../types.slint";
import { Art } from "../widgets/art.slint";
import { Icon, IconButton } from "../widgets/buttons.slint";
import { MenuDivider, MenuEntry, PopupMenu } from "../widgets/menu.slint";
import { Equalizer } from "../widgets/spinner.slint";

/// The queue row being dragged, where it would land, and whether it is
/// near or past the list's top (-1) or bottom (1) edge, so the list scrolls.
export global Drag {
    in-out property <int> from: -1;
    in-out property <int> target;
    in-out property <int> edge;
}

export component PanelAction inherits Text {
    callback clicked();
    vertical-alignment: center;
    font-size: 13px;
    font-weight: 600;
    color: touch.has-hover ? Theme.text : Theme.text-secondary;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    in property <int> index;
    in property <int> count;
    /// How many rows are selected; actions on a selected row apply to all.
    in property <int> selected-count;
    /// The list's scroll offset and visible height, to follow the pointer
    /// as the list scrolls under it.
    in property <length> scroll;
    in property <length> viewport;
    callback clicked(control: bool, shift: bool);
    callback remove();
    callback remove-selected();
    callback play-next();
    callback play-next-selected();
    callback drag-to(target: int);
    property <bool> many: root.item.selected && root.selected-count > 1;
    /// One song's YouTube actions, which a local file has none of.
    property <bool> youtube: Api.signed-in && !root.many && !root.item.local;
    property <bool> dragging;
    property <length> pressed-y;
    /// Pressed here: closing a menu takes the press, and its release alone isn't a click.
    property <bool> held;
    /// Where the pointer is in the list's viewport.
    property <length> pointer-y;
    property <int> target: clamp(floor((root.pointer-y - root.scroll) / Theme.queue-row), 0, root.count - 1);
    // The remove button counts as hovering the row, or they would flicker;
    // nothing is hot while a row is dragged over the others.
    property <bool> hot: (touch.has-hover || remove-button.has-hover) && Drag.from < 0;
    height: Theme.queue-row;
    z: root.dragging ? 1 : 0;

    function track-pointer() {
        root.pointer-y = root.y + root.scroll + touch.mouse-y;
        Drag.edge = root.pointer-y < 24px ? -1 : root.pointer-y > root.viewport - 24px ? 1 : 0;
        Drag.target = root.target;
    }

    function stop-dragging() {
        root.dragging = false;
        Drag.from = -1;
        Drag.edge = 0;
    }

    /// Where the menu was asked for, in window coordinates.
    property <Point> menu-at;

    menu := PopupMenu {
        x: root.menu-at.x - root.absolute-position.x;
        y: root.menu-at.y - root.absolute-position.y;
        MenuEntry {
            text: root.many ? "Play " + root.selected-count + " next" : "Play next";
            icon: Icons.play-next;
            enabled: root.many || !root.item.current;
            activated => {
                if root.many {
                    root.play-next-selected();
                } else {
                    root.play-next();
                }
            }
        }

        MenuEntry {
            text: root.many ? "Remove " + root.selected-count + " from queue" : "Remove from queue";
            icon: Icons.close;
            enabled: root.many || !root.item.current;
            activated => {
                if root.many {
                    root.remove-selected();
                } else {
                    root.remove();
                }
            }
        }

        if root.youtube: MenuDivider { }

        if root.youtube: MenuEntry {
            text: Api.rating-of(root.item.id) == 1 ? "Remove from liked songs" : "Like";
            icon: Api.rating-of(root.item.id) == 1 ? Icons.thumb-up-filled : Icons.thumb-up;
            active: Api.rating-of(root.item.id) == 1;
            activated => { Api.rate(root.item.id, 1); }
        }

        if root.youtube: MenuEntry {
            text: Api.rating-of(root.item.id) == 2 ? "Remove dislike" : "Dislike";
            icon: Api.rating-of(root.item.id) == 2 ? Icons.thumb-down-filled : Icons.thumb-down;
            active: Api.rating-of(root.item.id) == 2;
            activated => { Api.rate(root.item.id, 2); }
        }

        if root.youtube && !root.item.current: MenuEntry {
            text: "Remove rating";
            icon: Icons.close;
            activated => { Api.rate(root.item.id, 0); }
        }

        if root.youtube: MenuEntry {
            text: "Save to playlist";
            icon: Icons.save-to-playlist;
            activated => { Api.save-to-playlist(root.item.id); }
        }
    }

    touch := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(ev) => {
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up && !root.dragging {
                root.menu-at = { x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y };
                menu.show();
            }
            if ev.button != PointerEventButton.left {
                return;
            }
            if ev.kind == PointerEventKind.down {
                root.pressed-y = self.mouse-y;
                root.held = true;
            } else if ev.kind == PointerEventKind.up {
                if root.dragging {
                    root.stop-dragging();
                    root.drag-to(root.target);
                } else if root.held {
                    root.clicked(ev.modifiers.control, ev.modifiers.shift);
                }
                root.held = false;
            } else if ev.kind == PointerEventKind.cancel {
                root.stop-dragging();
                root.held = false;
            }
        }
        moved => {
            if !root.dragging && self.pressed && abs(self.mouse-y - root.pressed-y) > 6px {
                root.dragging = true;
                Drag.from = root.index;
            }
            if root.dragging {
                root.track-pointer();
            }
        }
    }

    // Follows the pointer while dragged; otherwise sits in the row.
    Rectangle {
        y: root.dragging ? root.pointer-y - root.scroll - root.y - root.pressed-y : 0;
        border-radius: 6px;
        background: root.dragging ? Theme.menu : root.item.selected ? Theme.highlight : root.hot ? Theme.hover : transparent;
        drop-shadow-blur: root.dragging ? 16px : 0;
        drop-shadow-color: #00000080;
        animate background { duration: Theme.fast; }

        Art {
            x: 8px;
            width: 44px;
            height: 44px;
            source: root.item.art;
        }

        if root.item.current: Rectangle {
            x: 8px;
            width: 44px;
            height: 44px;
            border-radius: 4px;
            background: #00000090;
            Equalizer {
                active: Api.is-playing;
                color: Theme.on-colour;
            }
        }
        VerticalLayout {
            x: 64px;
            width: parent.width - 64px - 56px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.title;
                overflow: elide;
                font-size: 14px;
                font-weight: 500;
                color: root.item.current ? Theme.accent : Theme.text;
            }

            HorizontalLayout {
                spacing: 4px;
                if root.item.recommended: Icon {
                    y: (parent.height - self.height) / 2;
                    path: Icons.sparkle;
                    size: 12px;
                    color: Theme.text-secondary;
                }

                Text {
                    text: root.item.artists;
                    overflow: elide;
                    font-size: 13px;
                    color: Theme.text-secondary;
                }
            }
        }

        remove-button := IconButton {
            x: parent.width - self.width - 8px;
            icon: Icons.close;
            enabled: root.hot && !root.item.current;
            opacity: self.enabled ? 1 : 0;
            clicked => { root.remove(); }
        }

        if !root.hot || root.item.current: Text {
            x: parent.width - 52px;
            width: 40px;
            height: 100%;
            text: root.item.duration;
            color: Theme.text-secondary;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
