import { ScrollView, TextEdit } from "std-widgets.slint";
import { ListView } from "list.slint";
import { Theme, Icons } from "theme.slint";
import {
    Icon,
    IconButton,
    PlayButton,
    PillButton,
    Art,
    Slider,
    Spinner,
    Toggle,
    Equalizer,
} from "widgets.slint";
import { PageRow, Layout } from "rows.slint";
import {
    Api,
    TrackItem,
    CardItem,
    RowItem,
    RowKind,
    QueueItem,
} from "types.slint";

export {
    Api,
    TrackItem,
    CardItem,
    RowItem,
    RowKind,
    QueueItem,
}

/// YouTube Music's mark: a red disc with a ring and a centred play triangle.
component Logo {
    width: 32px;
    height: 32px;
    Rectangle {
        border-radius: self.width / 2;
        background: #ff0000;
    }

    Rectangle {
        width: 60%;
        height: 60%;
        border-radius: self.width / 2;
        border-width: 1.6px;
        border-color: white;
    }

    Icon {
        path: Icons.play;
        size: 12px;
        color: white;
    }
}

component SearchBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <[string]> suggestions;
    out property <bool> focused: input.has-focus;
    callback accepted(string);
    callback edited(string);
    /// The box is done with the keyboard; the window takes it back.
    callback release-focus();
    public function focus-input() {
        input.focus();
        input.select-all();
    }

    height: 48px;
    border-radius: self.height / 2;
    background: input.has-focus || touch.has-hover ? Theme.highlight : Theme.elevated;
    border-width: 2px;
    border-color: input.has-focus ? Theme.text : transparent;
    animate background, border-color { duration: Theme.fast; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    Icon {
        x: 14px;
        path: Icons.search;
        size: 22px;
        color: input.has-focus ? Theme.text : Theme.text-secondary;
    }

    input := TextInput {
        x: 48px;
        width: parent.width - 48px - 44px;
        height: 100%;
        vertical-alignment: center;
        single-line: true;
        font-size: 15px;
        color: Theme.text;
        selection-background-color: #ff003380;
        accepted => {
            root.accepted(self.text);
            root.release-focus();
        }
        edited => { root.edited(self.text); }
        key-pressed(ev) => {
            if ev.text == Key.Escape {
                root.release-focus();
                return accept;
            }
            reject
        }
    }

    if input.text == "": Text {
        x: 48px;
        height: 100%;
        vertical-alignment: center;
        text: "What do you want to play?";
        color: Theme.text-dim;
        font-size: 15px;
    }
    if input.text != "": IconButton {
        x: parent.width - self.width - 8px;
        icon: Icons.close;
        size: 32px;
        icon-size: 18px;
        clicked => {
            input.text = "";
            root.edited("");
            input.focus();
        }
    }

    if input.has-focus && root.suggestions.length > 0: Rectangle {
        y: root.height + 8px;
        height: root.suggestions.length * 44px + 16px;
        border-radius: 12px;
        background: Theme.menu;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #000000a0;
        for suggestion[i] in root.suggestions: Rectangle {
            x: 8px;
            y: 8px + i * 44px;
            width: parent.width - 16px;
            height: 44px;
            border-radius: 6px;
            background: s-touch.has-hover ? Theme.hover : transparent;
            Icon {
                x: 12px;
                path: Icons.search;
                size: 18px;
                color: Theme.text-secondary;
            }

            Text {
                x: 44px;
                width: parent.width - 56px;
                height: 100%;
                vertical-alignment: center;
                text: suggestion;
                font-size: 14px;
                color: Theme.text;
                overflow: elide;
            }

            s-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    input.text = suggestion;
                    root.accepted(suggestion);
                    root.release-focus();
                }
            }
        }
    }
}

component NavRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> wide;
    callback clicked();
    height: 44px;
    border-radius: 6px;
    background: root.active ? Theme.hover : touch.has-hover ? #ffffff0a : transparent;
    animate background { duration: Theme.fast; }
    Icon {
        x: root.wide ? 14px : (parent.width - self.width) / 2;
        path: root.icon;
        size: 24px;
        color: root.active || touch.has-hover ? Theme.text : Theme.text-secondary;
        animate x {
            duration: Theme.normal;
            easing: ease-in-out;
        }
    }

    if root.wide: Text {
        x: 54px;
        height: 100%;
        vertical-alignment: center;
        text: root.label;
        font-size: 15px;
        font-weight: 700;
        color: root.active || touch.has-hover ? Theme.text : Theme.text-secondary;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LibraryRow inherits Rectangle {
    in property <CardItem> item;
    in property <bool> wide;
    height: 64px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }
    Art {
        x: root.wide ? 8px : (parent.width - self.width) / 2;
        width: 48px;
        height: 48px;
        source: root.item.art;
        round: root.item.round;
    }

    if root.wide: VerticalLayout {
        x: 68px;
        width: parent.width - 76px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.item.title;
            font-size: 15px;
            font-weight: 500;
            color: Theme.text;
            overflow: elide;
        }

        Text {
            text: root.item.subtitle;
            font-size: 13px;
            color: Theme.text-secondary;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Api.navigate(root.item.kind, root.item.id, root.item.title); }
    }
}

component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 32px;
    width: text.preferred-width + 28px;
    border-radius: 16px;
    background: root.active ? Theme.text : touch.has-hover ? #ffffff26 : #ffffff14;
    animate background { duration: Theme.fast; }
    text := Text {
        text: root.label;
        font-size: 14px;
        font-weight: 600;
        color: root.active ? #000000 : Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// The queue row being dragged, where it would land, and whether it is
/// past the list's top (-1) or bottom (1) edge, so the list scrolls.
global Drag {
    in-out property <int> from: -1;
    in-out property <int> target;
    in-out property <int> edge;
}

/// A text button in a panel's header.
component PanelAction inherits Text {
    callback clicked();
    vertical-alignment: center;
    font-size: 13px;
    font-weight: 600;
    color: touch.has-hover ? Theme.text : Theme.text-secondary;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    in property <int> index;
    in property <int> count;
    /// How many rows are selected; actions on a selected row apply to all.
    in property <int> selected-count;
    /// The list's scroll offset and visible height, to follow the pointer
    /// as the list scrolls under it.
    in property <length> scroll;
    in property <length> viewport;
    callback clicked(control: bool, shift: bool);
    callback remove();
    callback remove-selected();
    callback play-next();
    callback play-next-selected();
    callback drag-to(target: int);
    property <bool> many: root.item.selected && root.selected-count > 1;
    property <bool> dragging;
    property <length> pressed-y;
    /// Where the pointer is in the list's viewport.
    property <length> pointer-y;
    property <int> target: clamp(floor((root.pointer-y - root.scroll) / Theme.queue-row), 0, root.count - 1);
    // The remove button counts as hovering the row, or they would flicker;
    // nothing is hot while a row is dragged over the others.
    property <bool> hot: (touch.has-hover || remove-button.has-hover) && Drag.from < 0;
    height: Theme.queue-row;
    z: root.dragging ? 1 : 0;

    function track-pointer() {
        root.pointer-y = root.y + root.scroll + touch.mouse-y;
        Drag.edge = root.pointer-y < 24px ? -1 : root.pointer-y > root.viewport - 24px ? 1 : 0;
        Drag.target = root.target;
    }

    function stop-dragging() {
        root.dragging = false;
        Drag.from = -1;
        Drag.edge = 0;
    }

    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: root.many ? "Play " + root.selected-count + " next" : "Play next";
                enabled: root.many || !root.item.current;
                activated => {
                    if root.many {
                        root.play-next-selected();
                    } else {
                        root.play-next();
                    }
                }
            }

            MenuItem {
                title: root.many ? "Remove " + root.selected-count + " from queue" : "Remove from queue";
                enabled: root.many || !root.item.current;
                activated => {
                    if root.many {
                        root.remove-selected();
                    } else {
                        root.remove();
                    }
                }
            }
        }

        touch := TouchArea {
            mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
            pointer-event(ev) => {
                if ev.button != PointerEventButton.left {
                    return;
                }
                if ev.kind == PointerEventKind.down {
                    root.pressed-y = self.mouse-y;
                } else if ev.kind == PointerEventKind.up {
                    if root.dragging {
                        root.stop-dragging();
                        root.drag-to(root.target);
                    } else {
                        root.clicked(ev.modifiers.control, ev.modifiers.shift);
                    }
                } else if ev.kind == PointerEventKind.cancel {
                    root.stop-dragging();
                }
            }
            moved => {
                if !root.dragging && self.pressed && abs(self.mouse-y - root.pressed-y) > 6px {
                    root.dragging = true;
                    Drag.from = root.index;
                }
                if root.dragging {
                    root.track-pointer();
                }
            }
        }

        // Follows the pointer while dragged; otherwise sits in the row.
        Rectangle {
            y: root.dragging ? root.pointer-y - root.scroll - root.y - root.pressed-y : 0;
            border-radius: 6px;
            background: root.dragging ? Theme.menu : root.item.selected ? Theme.highlight : root.hot ? Theme.hover : transparent;
            drop-shadow-blur: root.dragging ? 16px : 0;
            drop-shadow-color: #00000080;
            animate background { duration: Theme.fast; }

            Art {
                x: 8px;
                width: 44px;
                height: 44px;
                source: root.item.art;
            }

            if root.item.current: Rectangle {
                x: 8px;
                width: 44px;
                height: 44px;
                border-radius: 4px;
                background: #00000090;
                Equalizer {
                    active: Api.is-playing;
                    color: Theme.text;
                }
            }
            VerticalLayout {
                x: 64px;
                width: parent.width - 64px - 56px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.item.title;
                    overflow: elide;
                    font-size: 14px;
                    font-weight: 500;
                    color: root.item.current ? Theme.accent : Theme.text;
                }

                HorizontalLayout {
                    spacing: 4px;
                    // Marks a track Smart Shuffle mixed in.
                    if root.item.recommended: Icon {
                        y: (parent.height - self.height) / 2;
                        path: Icons.sparkle;
                        size: 12px;
                        color: Theme.text-secondary;
                    }

                    Text {
                        text: root.item.artists;
                        overflow: elide;
                        font-size: 13px;
                        color: Theme.text-secondary;
                    }
                }
            }

            remove-button := IconButton {
                x: parent.width - self.width - 8px;
                icon: Icons.close;
                size: 32px;
                icon-size: 18px;
                enabled: root.hot && !root.item.current;
                opacity: self.enabled ? 1 : 0;
                clicked => { root.remove(); }
            }

            if !root.hot || root.item.current: Text {
                x: parent.width - 52px;
                width: 40px;
                height: 100%;
                text: root.item.duration;
                color: Theme.text-secondary;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

/// A modal card that fades and scales in, and out again once `open` is
/// cleared; the owner removes it after `Theme.normal`.
component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> dialog-width: 520px;
    in property <bool> open: true;
    callback close();
    // The first frame draws the closed look, so the opening animates
    // from it; a value set before any frame has nothing to animate from.
    property <bool> started;
    property <bool> shown: root.open && root.started;
    Timer {
        interval: 16ms;
        running: !root.started;
        triggered => { root.started = true; }
    }
    background: root.shown ? #000000b0 : #00000000;
    animate background { duration: Theme.normal; }
    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: root.dialog-width;
        height: body.preferred-height;
        border-radius: 12px;
        background: Theme.menu;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #000000b0;
        opacity: root.shown ? 1 : 0;
        transform-scale: root.shown ? 1.0 : 0.95;
        animate opacity, transform-scale {
            duration: Theme.normal;
            easing: ease-out;
        }
        TouchArea { }

        body := VerticalLayout {
            padding: 28px;
            spacing: 18px;
            HorizontalLayout {
                Text {
                    text: root.title;
                    font-size: 24px;
                    font-weight: 800;
                    font-family: Theme.display-font;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                IconButton {
                    icon: Icons.close;
                    size: 32px;
                    icon-size: 20px;
                    clicked => { root.close(); }
                }
            }

            @children
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;
    spacing: 24px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
        }

        if root.detail != "": Text {
            text: root.detail;
            font-size: 13px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }

    @children
}

component ToggleRow inherits SettingRow {
    in property <bool> checked;
    callback toggled(bool);
    Toggle {
        y: (parent.height - self.height) / 2;
        checked: root.checked;
        toggled(v) => { root.toggled(v); }
    }
}

export component AppWindow inherits Window {
    title: "YouTube Music";
    icon: @image-url("../app-icon.png");
    background: Theme.background;
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 960px;
    min-height: 620px;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    // Navigation and page
    in property <[RowItem]> rows;
    in property <bool> page-loading;
    in property <string> page-error;
    in property <string> page-title;
    in property <bool> page-can-play;
    in property <color> accent: Theme.home-tint;
    in property <string> nav-current: "home";
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <[string]> suggestions;
    in-out property <string> search-text;
    in-out property <length> page-scroll;

    // Now playing
    in property <bool> has-track;
    in property <string> np-title;
    in property <string> np-artists;
    in property <string> np-album;
    in property <image> np-art;
    in property <color> np-accent: #3a3a3a;
    in property <float> np-duration;
    in property <float> np-position;
    in property <float> np-buffered;
    in property <bool> np-playing;
    in property <bool> np-loading;
    in property <bool> np-premium;
    in property <string> np-quality;
    in property <bool> np-has-artist;
    in property <bool> np-has-album;
    in-out property <float> volume: 0.8;
    in property <bool> muted;
    in property <bool> shuffle;
    in property <bool> smart-shuffle;
    in property <int> repeat-mode;

    // Panels
    in-out property <bool> sidebar-collapsed;
    in property <[CardItem]> library;
    in-out property <bool> panel-open;
    in-out property <int> panel-tab;
    in property <[QueueItem]> queue;
    in property <int> queue-current;
    /// Rows picked with Ctrl- or Shift-click.
    in property <int> queue-selected;
    in property <string> lyrics;
    in property <bool> lyrics-loading;

    // Account and settings
    in property <bool> signed-in;
    in property <image> account-photo;
    in property <bool> signing-in;
    in property <bool> signing-in-browser;
    in-out property <string> pasted-cookie;
    in property <string> sign-in-error;
    in-out property <bool> settings-open;
    in-out property <bool> sign-in-open;
    in property <bool> normalise;
    in property <bool> discord;
    in property <bool> autoplay;
    /// 0 low, 1 normal, 2 high.
    in property <int> quality: 2;
    in property <bool> crossfade;
    in property <string> premium-status;
    // A newer version to install, or empty, and the Updates row's text.
    in property <string> update-version;
    in property <string> update-status;
    in property <bool> update-busy;
    in property <bool> check-updates;

    in property <string> toast;
    in property <bool> toast-visible;
    /// Flipped after restoring from minimised: the full-window background
    /// changes by one shade, forcing a complete repaint.
    in property <bool> repaint-flip;

    callback go(nav: string);
    callback back();
    callback forward();
    callback search(query: string);
    callback search-edited(query: string);
    callback toggle-play();
    callback next();
    callback previous();
    callback seek(fraction: float);
    callback set-volume(value: float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback queue-clicked(index: int, control: bool, shift: bool);
    callback queue-move(from: int, to: int);
    callback queue-remove(index: int);
    callback queue-remove-selected();
    callback queue-play-next(index: int);
    callback queue-play-next-selected();
    callback queue-clear-selection();
    callback queue-clear();
    callback queue-save();
    callback panel-tab-changed(tab: int);
    callback sidebar-changed(collapsed: bool);
    callback np-go-artist();
    callback np-go-album();
    callback sign-in(cookie: string);
    callback sign-in-browser();
    callback sign-out();
    callback set-normalise(value: bool);
    callback set-discord(value: bool);
    callback set-check-updates(value: bool);
    callback install-update();
    callback set-autoplay(value: bool);
    callback set-quality(value: int);
    callback set-crossfade(value: bool);
    // Delivered from background threads through the event loop.
    callback player-event(kind: string, message: string);
    callback media-action(action: string, value: float);

    pure function fmt(secs: float) -> string {
        if secs < 0 {
            return "0:00";
        }
        let total = floor(secs);
        let h = floor(total / 3600);
        let m = mod(floor(total / 60), 60);
        let s = mod(total, 60);
        let ss = s < 10 ? "0" + s : "" + s;
        if h > 0 {
            return h + ":" + (m < 10 ? "0" + m : "" + m) + ":" + ss;
        }
        return m + ":" + ss;
    }

    function open-panel(tab: int) {
        if root.panel-open && root.panel-tab == tab {
            root.panel-open = false;
        } else {
            root.panel-open = true;
            root.panel-tab = tab;
            root.panel-tab-changed(tab);
        }
    }

    function toggle-sidebar() {
        root.sidebar-collapsed = !root.sidebar-collapsed;
        root.sidebar-changed(root.sidebar-collapsed);
    }

    // A dialog stays for its closing animation, then goes.
    property <bool> settings-shown;
    changed settings-open => {
        if root.settings-open {
            root.settings-shown = true;
        } else {
            settings-closer.running = true;
        }
    }
    settings-closer := Timer {
        interval: Theme.normal;
        running: false;
        triggered => {
            self.running = false;
            root.settings-shown = root.settings-open;
        }
    }
    property <bool> sign-in-shown;
    changed sign-in-open => {
        if root.sign-in-open {
            root.sign-in-shown = true;
        } else {
            sign-in-closer.running = true;
        }
    }
    sign-in-closer := Timer {
        interval: Theme.normal;
        running: false;
        triggered => {
            self.running = false;
            root.sign-in-shown = root.sign-in-open;
        }
    }

    public function focus-search() {
        search-box.focus-input();
    }

    Rectangle {
        background: root.repaint-flip ? #010101 : Theme.background;
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(ev) => {
            if ev.text == Key.Escape && (root.settings-open || root.sign-in-open) {
                root.settings-open = false;
                root.sign-in-open = false;
                return accept;
            }
            if ev.text == Key.Escape && root.queue-selected > 0 {
                root.queue-clear-selection();
                return accept;
            }
            if ev.text == Key.Delete && root.queue-selected > 0 && !search-box.focused {
                root.queue-remove-selected();
                return accept;
            }
            if ev.text == " " && !search-box.focused {
                root.toggle-play();
                return accept;
            }
            if ev.modifiers.control && (ev.text == "f" || ev.text == "k" || ev.text == "l") {
                search-box.focus-input();
                return accept;
            }
            if ev.modifiers.control && ev.text == "b" {
                root.toggle-sidebar();
                return accept;
            }
            if ev.modifiers.control && ev.text == Key.RightArrow {
                root.next();
                return accept;
            }
            if ev.modifiers.control && ev.text == Key.LeftArrow {
                root.previous();
                return accept;
            }
            if ev.modifiers.alt && ev.text == Key.LeftArrow {
                root.back();
                return accept;
            }
            if ev.modifiers.alt && ev.text == Key.RightArrow {
                root.forward();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-left: Theme.gap;
            padding-right: Theme.gap;

            // Top bar
            Rectangle {
                height: Theme.top-bar;
                z: 10;
                Logo {
                    x: 16px;
                }

                IconButton {
                    x: 64px;
                    icon: Icons.back;
                    size: 32px;
                    icon-size: 22px;
                    color: Theme.text;
                    background: Theme.elevated;
                    enabled: root.can-back;
                    clicked => { root.back(); }
                }

                IconButton {
                    x: 104px;
                    icon: Icons.forward;
                    size: 32px;
                    icon-size: 22px;
                    color: Theme.text;
                    background: Theme.elevated;
                    enabled: root.can-forward;
                    clicked => { root.forward(); }
                }

                HorizontalLayout {
                    x: (parent.width - self.width) / 2;
                    width: min(560px, parent.width - 400px);
                    spacing: 8px;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: root.nav-current == "home" ? Icons.home : Icons.home-outline;
                        size: 48px;
                        icon-size: 24px;
                        color: root.nav-current == "home" ? Theme.text : Theme.text-secondary;
                        background: Theme.elevated;
                        hover-background: Theme.highlight;
                        show-dot: false;
                        clicked => { root.go("home"); }
                    }

                    search-box := SearchBox {
                        y: (parent.height - self.height) / 2;
                        horizontal-stretch: 1;
                        text <=> root.search-text;
                        suggestions: root.suggestions;
                        accepted(q) => { root.search(q); }
                        edited(q) => { root.search-edited(q); }
                        release-focus => { keys.focus(); }
                    }
                }

                // The account button opens Settings, which holds sign-in
                // and sign-out too. A dot on it marks a waiting update.
                Rectangle {
                    x: parent.width - self.width - 8px;
                    y: (parent.height - self.height) / 2;
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: account-touch.has-hover ? Theme.highlight : Theme.elevated;
                    animate background { duration: Theme.fast; }
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        background: root.signed-in ? Theme.accent : #535353;
                        Icon {
                            path: Icons.account;
                            size: 18px;
                            color: Theme.text;
                        }

                        if root.signed-in && root.account-photo.width > 0: Art {
                            width: 100%;
                            height: 100%;
                            round: true;
                            source: root.account-photo;
                        }
                    }

                    if root.update-version != "": Rectangle {
                        x: parent.width - self.width + 1px;
                        y: -1px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Theme.accent;
                        border-width: 2px;
                        border-color: Theme.background;
                    }

                    account-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.settings-open = true; }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: Theme.gap;

                // Your Library
                sidebar := Rectangle {
                    property <bool> wide: self.width > 200px;
                    width: root.sidebar-collapsed ? Theme.sidebar-narrow : Theme.sidebar-wide;
                    animate width {
                        duration: 260ms;
                        easing: ease-in-out;
                    }
                    border-radius: Theme.panel-radius;
                    background: Theme.panel;
                    clip: true;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        Rectangle {
                            height: 52px;
                            library-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-sidebar(); }
                            }

                            Icon {
                                x: sidebar.wide ? 14px : (parent.width - self.width) / 2;
                                path: sidebar.wide ? Icons.collapse : Icons.library;
                                size: 24px;
                                color: library-touch.has-hover ? Theme.text : Theme.text-secondary;
                            }

                            if sidebar.wide: Text {
                                x: 54px;
                                height: 100%;
                                vertical-alignment: center;
                                text: "Your Library";
                                font-size: 16px;
                                font-weight: 700;
                                color: library-touch.has-hover ? Theme.text : Theme.text-secondary;
                            }
                        }

                        NavRow {
                            icon: Icons.home;
                            label: "Home";
                            wide: sidebar.wide;
                            active: root.nav-current == "home";
                            clicked => { root.go("home"); }
                        }

                        NavRow {
                            icon: Icons.explore;
                            label: "Explore";
                            wide: sidebar.wide;
                            active: root.nav-current == "explore";
                            clicked => { root.go("explore"); }
                        }

                        NavRow {
                            icon: Icons.library;
                            label: "Library";
                            wide: sidebar.wide;
                            active: root.nav-current == "library";
                            clicked => { root.go("library"); }
                        }

                        NavRow {
                            icon: Icons.history;
                            label: "History";
                            wide: sidebar.wide;
                            active: root.nav-current == "history";
                            clicked => { root.go("history"); }
                        }

                        Rectangle {
                            height: 17px;
                            Rectangle {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 1px;
                                background: Theme.divider;
                            }
                        }

                        if root.signed-in: library-list := ListView {
                            vertical-stretch: 1;
                            for item in root.library: LibraryRow {
                                width: library-list.visible-width;
                                item: item;
                                wide: sidebar.wide;
                            }
                        }
                        if !root.signed-in && sidebar.wide: Rectangle {
                            height: card.preferred-height;
                            border-radius: 8px;
                            background: Theme.elevated;
                            card := VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text {
                                    text: "Bring your library";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: Theme.text;
                                }

                                Text {
                                    text: "Sign in to see your playlists, albums and listening history here.";
                                    font-size: 13px;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    padding-top: 6px;
                                    PillButton {
                                        text: "Sign in";
                                        primary: true;
                                        small: true;
                                        clicked => { root.sign-in-open = true; }
                                    }
                                }
                            }
                        }
                        if !root.signed-in: Rectangle {
                            vertical-stretch: 1;
                        }
                    }
                }

                // Main panel
                main := Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.panel-radius;
                    background: Theme.panel;
                    clip: true;

                    // Tint behind the top of the page, scrolling with it.
                    Rectangle {
                        y: root.page-scroll;
                        height: 420px;
                        background: @linear-gradient(180deg, root.accent 0%, Theme.panel 100%);
                        animate background { duration: 500ms; }
                    }

                    content := Rectangle {
                        opacity: root.page-loading || root.page-error != "" ? 0 : 1;
                        y: root.page-loading ? 16px : 0px;
                        animate opacity { duration: 260ms; }
                        animate y {
                            duration: 320ms;
                            easing: ease-out;
                        }
                        list := ListView {
                            width: 100%;
                            height: 100%;
                            content-y <=> root.page-scroll;
                            for row in root.rows: PageRow {
                                data: row;
                                content-width: list.visible-width;
                            }
                        }
                    }

                    // Sticky title once the header scrolls away.
                    Rectangle {
                        y: 0;
                        height: 64px;
                        background: root.accent.darker(0.35);
                        opacity: root.page-title != "" && -root.page-scroll > 280px ? 1 : 0;
                        visible: self.opacity > 0;
                        animate opacity { duration: Theme.normal; }
                        TouchArea { }

                        HorizontalLayout {
                            padding-left: Theme.page-padding;
                            spacing: 12px;
                            if root.page-can-play: PlayButton {
                                y: (parent.height - self.height) / 2;
                                size: 44px;
                                clicked => { Api.header-action("play"); }
                            }
                            Text {
                                text: root.page-title;
                                vertical-alignment: center;
                                font-size: 22px;
                                font-weight: 800;
                                font-family: Theme.display-font;
                                color: Theme.text;
                                overflow: elide;
                            }
                        }
                    }

                    if root.page-loading: Spinner {
                        size: 40px;
                    }
                    if !root.page-loading && root.page-error != "": VerticalLayout {
                        alignment: center;
                        spacing: 20px;
                        padding: 48px;
                        Text {
                            text: root.page-error;
                            horizontal-alignment: center;
                            font-size: 18px;
                            font-weight: 600;
                            color: Theme.text;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: center;
                            PillButton {
                                text: root.nav-current == "library" && !root.signed-in ? "Sign in" : "Try again";
                                primary: true;
                                clicked => {
                                    if root.nav-current == "library" && !root.signed-in {
                                        root.sign-in-open = true;
                                    } else {
                                        root.go("reload");
                                    }
                                }
                            }
                        }
                    }
                }

                // Up next and lyrics
                Rectangle {
                    width: root.panel-open ? Theme.right-panel : 0px;
                    animate width {
                        duration: 260ms;
                        easing: ease-in-out;
                    }
                    visible: self.width > 1px;
                    border-radius: Theme.panel-radius;
                    background: Theme.panel;
                    clip: true;

                    Rectangle {
                        x: 0;
                        width: Theme.right-panel;
                        if root.panel-tab == 1: Rectangle {
                            background: @linear-gradient(180deg, root.np-accent 0%, root.np-accent.darker(0.5) 100%);
                            animate background { duration: 500ms; }
                        }
                        VerticalLayout {
                            padding-top: 12px;
                            HorizontalLayout {
                                height: 48px;
                                padding-left: 16px;
                                padding-right: 12px;
                                spacing: 8px;
                                Pill {
                                    y: (parent.height - self.height) / 2;
                                    label: "Up next";
                                    active: root.panel-tab == 0;
                                    clicked => {
                                        root.panel-tab = 0;
                                        root.panel-tab-changed(0);
                                    }
                                }

                                Pill {
                                    y: (parent.height - self.height) / 2;
                                    label: "Lyrics";
                                    active: root.panel-tab == 1;
                                    clicked => {
                                        root.panel-tab = 1;
                                        root.panel-tab-changed(1);
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.close;
                                    size: 32px;
                                    icon-size: 18px;
                                    clicked => { root.panel-open = false; }
                                }
                            }

                            if root.panel-tab == 0: VerticalLayout {
                                vertical-stretch: 1;
                                HorizontalLayout {
                                    height: 44px;
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 14px;
                                    Text {
                                        text: root.queue.length == 0 ? ""
                                            : root.queue-selected > 0 ? root.queue-selected + " selected"
                                            : "Queue  •  " + root.queue.length + (root.queue.length == 1 ? " song" : " songs");
                                        vertical-alignment: center;
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: Theme.text;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    if root.queue-selected > 0: PanelAction {
                                        text: "Play next";
                                        clicked => { root.queue-play-next-selected(); }
                                    }
                                    if root.queue-selected > 0: PanelAction {
                                        text: "Remove";
                                        clicked => { root.queue-remove-selected(); }
                                    }
                                    if root.queue-selected > 0: IconButton {
                                        y: (parent.height - self.height) / 2;
                                        icon: Icons.close;
                                        size: 28px;
                                        icon-size: 16px;
                                        clicked => { root.queue-clear-selection(); }
                                    }
                                    if root.queue-selected == 0 && root.signed-in && root.queue.length > 0: PanelAction {
                                        text: "Save";
                                        clicked => { root.queue-save(); }
                                    }
                                    if root.queue-selected == 0 && root.queue.length > 1: PanelAction {
                                        text: "Clear";
                                        clicked => { root.queue-clear(); }
                                    }
                                }

                                if root.queue.length > 0: Rectangle {
                                    vertical-stretch: 1;
                                    queue-list := ListView {
                                        for item[i] in root.queue: QueueRow {
                                            x: 8px;
                                            width: queue-list.visible-width - 16px;
                                            item: item;
                                            index: i;
                                            count: root.queue.length;
                                            selected-count: root.queue-selected;
                                            scroll: queue-list.content-y;
                                            viewport: queue-list.visible-height;
                                            clicked(control, shift) => { root.queue-clicked(i, control, shift); }
                                            remove => { root.queue-remove(i); }
                                            remove-selected => { root.queue-remove-selected(); }
                                            play-next => { root.queue-play-next(i); }
                                            play-next-selected => { root.queue-play-next-selected(); }
                                            drag-to(target) => { root.queue-move(i, target); }
                                        }
                                    }

                                    // Where the dragged row will land.
                                    if Drag.from >= 0: Rectangle {
                                        x: 8px;
                                        y: queue-list.content-y + (Drag.target + (Drag.target > Drag.from ? 1 : 0)) * Theme.queue-row - 1px;
                                        width: queue-list.visible-width - 16px;
                                        height: 2px;
                                        background: Theme.accent;
                                    }

                                    // Scrolls the list while a row is dragged past its edge.
                                    Timer {
                                        interval: 16ms;
                                        running: Drag.from >= 0 && Drag.edge != 0;
                                        triggered => {
                                            queue-list.content-y = clamp(queue-list.content-y - Drag.edge * 8px,
                                                min(0px, queue-list.visible-height - queue-list.content-height), 0px);
                                        }
                                    }
                                }
                                if root.queue.length == 0: VerticalLayout {
                                    vertical-stretch: 1;
                                    alignment: center;
                                    spacing: 8px;
                                    Icon {
                                        x: (parent.width - self.width) / 2;
                                        path: Icons.queue;
                                        size: 48px;
                                        color: Theme.text-dim;
                                    }

                                    Text {
                                        text: "Your queue is empty";
                                        horizontal-alignment: center;
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: Theme.text;
                                    }

                                    Text {
                                        text: "Play something and it shows up here.";
                                        horizontal-alignment: center;
                                        color: Theme.text-secondary;
                                    }
                                }
                            }
                            if root.panel-tab == 1: Rectangle {
                                vertical-stretch: 1;
                                if root.lyrics-loading: Spinner {
                                    size: 32px;
                                }
                                if !root.lyrics-loading: ScrollView {
                                    width: 100%;
                                    height: 100%;
                                    content-height: lyrics-text.preferred-height + 48px;
                                    lyrics-text := Text {
                                        x: 24px;
                                        y: 16px;
                                        width: parent.width - 48px;
                                        text: root.lyrics;
                                        wrap: word-wrap;
                                        font-size: 22px;
                                        font-weight: 700;
                                        font-family: Theme.display-font;
                                        color: Theme.text;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Player bar
            Rectangle {
                height: Theme.player-bar;

                // Now playing
                HorizontalLayout {
                    x: 8px;
                    width: parent.width * 0.3;
                    spacing: 14px;
                    opacity: root.has-track ? 1 : 0;
                    animate opacity { duration: Theme.normal; }
                    Art {
                        y: (parent.height - self.height) / 2;
                        width: 56px;
                        height: 56px;
                        source: root.np-art;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: #00000080;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.np-title;
                            overflow: elide;
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text;
                            TouchArea {
                                mouse-cursor: root.np-has-album ? pointer : default;
                                clicked => { root.np-go-album(); }
                            }
                        }

                        Text {
                            text: root.np-artists;
                            overflow: elide;
                            font-size: 12px;
                            color: a-touch.has-hover && root.np-has-artist ? Theme.text : Theme.text-secondary;
                            a-touch := TouchArea {
                                mouse-cursor: root.np-has-artist ? pointer : default;
                                clicked => { root.np-go-artist(); }
                            }
                        }
                    }
                }

                // Transport
                VerticalLayout {
                    x: (parent.width - self.width) / 2;
                    width: min(640px, parent.width * 0.4);
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 16px;
                        // Off, shuffle, then Smart Shuffle, shown as sparkles.
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: root.smart-shuffle ? Icons.sparkle : Icons.shuffle;
                            size: 32px;
                            icon-size: 18px;
                            active: root.shuffle;
                            clicked => { root.toggle-shuffle(); }
                        }

                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.previous;
                            size: 32px;
                            icon-size: 22px;
                            enabled: root.has-track;
                            clicked => { root.previous(); }
                        }

                        Rectangle {
                            width: 36px;
                            height: 36px;
                            if root.np-loading: Spinner {
                                size: 28px;
                            }
                            if !root.np-loading: PlayButton {
                                size: 36px;
                                playing: root.np-playing;
                                color: Theme.text;
                                icon-color: #000000;
                                clicked => { root.toggle-play(); }
                            }
                        }

                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.next;
                            size: 32px;
                            icon-size: 22px;
                            enabled: root.has-track;
                            clicked => { root.next(); }
                        }

                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: root.repeat-mode == 2 ? Icons.repeat-one : Icons.repeat;
                            size: 32px;
                            icon-size: 18px;
                            active: root.repeat-mode != 0;
                            clicked => { root.cycle-repeat(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 40px;
                            text: root.fmt(root.np-position);
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            font-size: 12px;
                            color: Theme.text-secondary;
                        }

                        Slider {
                            horizontal-stretch: 1;
                            enabled: root.has-track;
                            value: root.np-duration > 0 ? root.np-position / root.np-duration : 0;
                            buffered: root.np-buffered;
                            seek(f) => { root.seek(f); }
                        }

                        Text {
                            width: 40px;
                            text: root.fmt(root.np-duration);
                            vertical-alignment: center;
                            font-size: 12px;
                            color: Theme.text-secondary;
                        }
                    }
                }

                // Options
                HorizontalLayout {
                    x: parent.width - self.width - 8px;
                    width: self.preferred-width;
                    spacing: 4px;
                    // Quality badge; Premium streams get a red PREMIUM tag.
                    if root.np-quality != "": Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: badge.preferred-width;
                        height: 20px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.np-premium ? Theme.accent : #ffffff30;
                        clip: true;
                        badge := HorizontalLayout {
                            if root.np-premium: Rectangle {
                                width: tag.preferred-width + 12px;
                                background: Theme.accent;
                                tag := Text {
                                    text: "PREMIUM";
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 0.5px;
                                    color: Theme.text;
                                }
                            }
                            Rectangle {
                                width: quality.preferred-width + 14px;
                                quality := Text {
                                    text: root.np-quality;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    color: root.np-premium ? Theme.text : Theme.text-secondary;
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 4px;
                    }

                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.lyrics;
                        size: 32px;
                        icon-size: 18px;
                        active: root.panel-open && root.panel-tab == 1;
                        clicked => { root.open-panel(1); }
                    }

                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.queue;
                        size: 32px;
                        icon-size: 18px;
                        active: root.panel-open && root.panel-tab == 0;
                        clicked => { root.open-panel(0); }
                    }

                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: root.muted || root.volume == 0 ? Icons.volume-off : root.volume < 0.5 ? Icons.volume-low : Icons.volume;
                        size: 32px;
                        icon-size: 18px;
                        show-dot: false;
                        clicked => { root.toggle-mute(); }
                    }

                    Slider {
                        y: (parent.height - self.height) / 2;
                        width: 100px;
                        value: root.muted ? 0 : root.volume;
                        changed(v) => { root.set-volume(v); }
                        seek(v) => { root.set-volume(v); }
                    }

                    Rectangle {
                        width: 8px;
                    }
                }
            }
        }

        // Toast
        Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - Theme.player-bar - self.height - (root.toast-visible ? 20px : 0px);
            width: min(toast-text.preferred-width + 40px, root.width - 64px);
            height: toast-text.preferred-height + 22px;
            border-radius: 8px;
            background: Theme.text;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;
            opacity: root.toast-visible ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity, y {
                duration: Theme.normal;
                easing: ease-out;
            }
            toast-text := Text {
                width: parent.width - 40px;
                text: root.toast;
                wrap: word-wrap;
                horizontal-alignment: center;
                font-size: 14px;
                font-weight: 600;
                color: #000000;
            }
        }

        if root.settings-shown: Dialog {
            title: "Settings";
            open: root.settings-open;
            close => { root.settings-open = false; }
            SettingRow {
                label: "Audio quality";
                detail: root.quality == 0 ? "About 50 kbps, a third of the data of Normal. For a metered connection."
                    : root.quality == 1 ? "About 130 kbps, as YouTube Music plays without Premium."
                    : root.premium-status;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        for name[i] in ["Low", "Normal", "High"]: Pill {
                            label: name;
                            active: root.quality == i;
                            clicked => { root.set-quality(i); }
                        }
                    }
                }
            }

            ToggleRow {
                label: "Normalise volume";
                detail: "Plays every track at a similar loudness, as YouTube Music does.";
                checked: root.normalise;
                toggled(v) => { root.set-normalise(v); }
            }

            ToggleRow {
                label: "Crossfade";
                detail: "Fades each track into the next. Tracks of an album played in order still run straight on.";
                checked: root.crossfade;
                toggled(v) => { root.set-crossfade(v); }
            }

            ToggleRow {
                label: "Autoplay";
                detail: "Keeps playing similar music when the queue ends.";
                checked: root.autoplay;
                toggled(v) => { root.set-autoplay(v); }
            }

            ToggleRow {
                label: "Discord Rich Presence";
                detail: "Shows what you are listening to on Discord.";
                checked: root.discord;
                toggled(v) => { root.set-discord(v); }
            }

            SettingRow {
                label: "Updates";
                detail: root.update-status;
                if root.update-version != "" && !root.update-busy: PillButton {
                    y: (parent.height - self.height) / 2;
                    text: "Update to " + root.update-version;
                    primary: true;
                    small: true;
                    clicked => { root.install-update(); }
                }
                if root.update-version == "": Toggle {
                    y: (parent.height - self.height) / 2;
                    checked: root.check-updates;
                    toggled(v) => { root.set-check-updates(v); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            SettingRow {
                label: root.signed-in ? "Signed in" : "Not signed in";
                detail: root.signed-in ? "Your library and history come from your YouTube account." : "Sign in to see your library and history.";
                PillButton {
                    y: (parent.height - self.height) / 2;
                    text: root.signed-in ? "Sign out" : "Sign in";
                    small: true;
                    clicked => {
                        if root.signed-in {
                            root.sign-out();
                        } else {
                            root.settings-open = false;
                            root.sign-in-open = true;
                        }
                    }
                }
            }

            Text {
                text: "Shortcuts: Space play/pause • Ctrl+K search • Ctrl+B sidebar • Ctrl+←/→ previous/next";
                font-size: 12px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
        }

        if root.sign-in-shown: sign-in-dialog := Dialog {
            property <bool> pasting;
            title: "Sign in";
            dialog-width: 600px;
            open: root.sign-in-open;
            close => { root.sign-in-open = false; }
            Text {
                text: root.signing-in-browser
                    ? "Finish signing in in the Google window. It closes by itself once you're signed in."
                    : "Sign in with your Google account on Google's own page. Your password goes to Google only.";
                wrap: word-wrap;
                font-size: 13px;
                color: Theme.text-secondary;
            }

            if sign-in-dialog.pasting: Text {
                text: "Or paste the cookies of a signed-in music.youtube.com session: either a cookies.txt export or the Cookie request header from the browser's developer tools (Network tab). Use a private window and close it afterwards, as YouTube rotates cookies of open sessions.";
                wrap: word-wrap;
                font-size: 13px;
                color: Theme.text-secondary;
            }
            if sign-in-dialog.pasting: TextEdit {
                height: 160px;
                font-size: 12px;
                wrap: char-wrap;
                edited(text) => { root.pasted-cookie = text; }
            }
            if root.sign-in-error != "": Text {
                text: root.sign-in-error;
                wrap: word-wrap;
                font-size: 13px;
                color: #ff6b81;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 12px;
                if root.signing-in || root.signing-in-browser: Spinner {
                    size: 24px;
                }
                if !sign-in-dialog.pasting: PillButton {
                    text: "Paste cookies instead";
                    clicked => { sign-in-dialog.pasting = true; }
                }
                PillButton {
                    text: "Cancel";
                    clicked => { root.sign-in-open = false; }
                }

                if sign-in-dialog.pasting: PillButton {
                    text: "Sign in with cookies";
                    clicked => { root.sign-in(root.pasted-cookie); }
                }
                PillButton {
                    text: "Sign in with Google";
                    primary: true;
                    clicked => { root.sign-in-browser(); }
                }
            }
        }
    }
}

/// Holds Google's sign-in page, which the app places over it.
export component SignInWindow inherits Window {
    title: "Sign in to YouTube Music";
    icon: @image-url("../app-icon.png");
    background: Theme.background;
    preferred-width: 480px;
    preferred-height: 700px;
    min-width: 400px;
    min-height: 560px;
    callback resized();
    changed width => { root.resized(); }
    changed height => { root.resized(); }
}
