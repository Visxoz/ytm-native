import { EqualiserDialog } from "dialogs/equaliser.slint";
import { PlaylistPicker } from "dialogs/playlist-picker.slint";
import { SettingsDialog } from "dialogs/settings.slint";
import { SignInDialog } from "dialogs/sign-in.slint";
import { SidePanel } from "panel/side-panel.slint";
import { PageView } from "shell/page-view.slint";
import { PlayerBar } from "shell/player-bar.slint";
import { Sidebar } from "shell/sidebar.slint";
import { TopBar } from "shell/top-bar.slint";
import { Theme } from "theme.slint";
import { Api, CardItem, PlaylistChoice, QueueItem, RowItem, RowKind, TrackItem } from "types.slint";

export {
    Api,
    TrackItem,
    CardItem,
    RowItem,
    RowKind,
    QueueItem,
    PlaylistChoice,
}

export component AppWindow inherits Window {
    title: "YouTube Music";
    icon: @image-url("../app-icon.png");
    background: Theme.background;
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 960px;
    min-height: 620px;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    // Navigation and page
    in property <[RowItem]> rows;
    in property <bool> page-loading;
    in property <string> page-error;
    in property <string> page-title;
    in property <bool> page-can-play;
    in property <color> accent: Theme.home-tint;
    in property <string> nav-current: "home";
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <[string]> suggestions;
    in property <[string]> recent-searches;
    in-out property <string> search-text;
    in-out property <length> page-scroll;

    // Now playing
    in property <bool> has-track;
    in property <string> np-title;
    in property <string> np-artists;
    in property <image> np-art;
    in property <color> np-accent: #3a3a3a;
    in property <float> np-duration;
    in property <float> np-position;
    in property <float> np-buffered;
    in property <bool> np-playing;
    in property <bool> np-loading;
    in property <bool> np-premium;
    in property <string> np-quality;
    in property <bool> np-has-artist;
    in property <bool> np-has-album;
    in-out property <float> volume: 0.8;
    in property <bool> muted;
    in property <bool> shuffle;
    in property <bool> smart-shuffle;
    in property <int> repeat-mode;

    // Panels
    in-out property <bool> sidebar-collapsed;
    in property <[CardItem]> library;
    in-out property <bool> panel-open;
    in-out property <int> panel-tab;
    in property <[QueueItem]> queue;
    in property <int> queue-current;
    /// Rows picked with Ctrl- or Shift-click.
    in property <int> queue-selected;
    in property <[string]> lyrics;
    in property <bool> lyrics-synced;
    in property <int> lyrics-current: -1;
    in property <string> lyrics-source;
    in property <bool> lyrics-loading;

    // Account and settings
    in property <image> account-photo;
    in property <bool> signing-in;
    in property <bool> signing-in-browser;
    in-out property <string> pasted-cookie;
    in property <string> sign-in-error;
    in-out property <bool> settings-open;
    in-out property <bool> sign-in-open;
    in property <bool> normalise;
    in property <bool> discord;
    in property <bool> autoplay;
    /// 0 low, 1 normal, 2 high.
    in property <int> quality: 2;
    in property <bool> crossfade;
    in property <string> premium-status;
    // The equaliser.
    in-out property <bool> eq-open;
    in-out property <bool> equaliser;
    in property <[float]> eq-gains;
    in property <[string]> eq-bands;
    in property <[string]> eq-presets;
    /// The preset the gains match, or -1.
    in property <int> eq-preset;
    in property <float> eq-max-db;
    // Saving a song to a playlist.
    in-out property <bool> picker-open;
    in property <bool> picker-loading;
    in property <[PlaylistChoice]> playlist-choices;
    // A newer version to install, or empty, and the Updates row's text.
    in property <string> update-version;
    in property <string> update-status;
    in property <bool> update-busy;
    in property <bool> check-updates;

    in property <string> toast;
    in property <bool> toast-visible;
    /// Flipped after restoring from minimised: the full-window background
    /// changes by one shade, forcing a complete repaint.
    in property <bool> repaint-flip;

    callback go(nav: string);
    callback back();
    callback forward();
    callback search(query: string);
    callback search-edited(query: string);
    callback forget-search(query: string);
    callback toggle-play();
    callback next();
    callback previous();
    callback seek(fraction: float);
    callback set-volume(value: float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback queue-clicked(index: int, control: bool, shift: bool);
    callback queue-move(from: int, to: int);
    callback queue-remove(index: int);
    callback queue-remove-selected();
    callback queue-play-next(index: int);
    callback queue-play-next-selected();
    callback queue-clear-selection();
    callback queue-clear();
    callback queue-save();
    callback panel-tab-changed(tab: int);
    callback lyric-clicked(index: int);
    callback sidebar-changed(collapsed: bool);
    callback np-go-artist();
    callback np-go-album();
    callback sign-in(cookie: string);
    callback sign-in-browser();
    callback sign-out();
    callback set-normalise(value: bool);
    callback set-discord(value: bool);
    callback set-check-updates(value: bool);
    callback install-update();
    callback pick-playlist(index: int);
    callback set-autoplay(value: bool);
    callback set-quality(value: int);
    callback set-crossfade(value: bool);
    callback set-equaliser(on: bool);
    callback set-eq-preset(index: int);
    /// A band's slider, from 0 to 1, moved; `done` once it is let go.
    callback set-eq-band(band: int, value: float, done: bool);
    // Delivered from background threads through the event loop.
    callback player-event(kind: string, message: string);
    callback media-action(action: string, value: float);

    function open-panel(tab: int) {
        if root.panel-open && root.panel-tab == tab {
            root.panel-open = false;
        } else {
            root.panel-open = true;
            root.panel-tab = tab;
            root.panel-tab-changed(tab);
        }
    }

    property <bool> dialog-open: root.settings-open || root.sign-in-open || root.picker-open || root.eq-open;

    function toggle-sidebar() {
        root.sidebar-collapsed = !root.sidebar-collapsed;
        root.sidebar-changed(root.sidebar-collapsed);
    }

    // A dialog stays for its closing animation, then goes.
    property <bool> settings-shown;
    changed settings-open => {
        if root.settings-open {
            root.settings-shown = true;
        } else {
            settings-closer.running = true;
        }
    }
    settings-closer := Timer {
        interval: Theme.normal;
        running: false;
        triggered => {
            self.running = false;
            root.settings-shown = root.settings-open;
        }
    }
    property <bool> sign-in-shown;
    changed sign-in-open => {
        if root.sign-in-open {
            root.sign-in-shown = true;
        } else {
            sign-in-closer.running = true;
        }
    }
    sign-in-closer := Timer {
        interval: Theme.normal;
        running: false;
        triggered => {
            self.running = false;
            root.sign-in-shown = root.sign-in-open;
        }
    }

    public function focus-search() {
        top-bar.focus-input();
    }

    /// Hands the keyboard back from the search box, as when the page
    /// changes.
    public function close-search() {
        if top-bar.search-focused {
            top-bar.close();
        }
    }

    /// Closes the search box on a press outside it and its dropdown, in
    /// logical pixels from the window's corner. Only text inputs and focus
    /// scopes take focus on a click, so the page's rows and cards would
    /// leave the box focused, its dropdown over them. Focus is checked
    /// first, so the far commoner press with the box unfocused skips the
    /// hit test.
    public function close-search-outside(x: length, y: length) {
        if top-bar.search-focused && !top-bar.contains(x, y) {
            top-bar.close();
        }
    }

    Rectangle {
        background: root.repaint-flip ? #010101 : Theme.background;
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(ev) => {
            if ev.text == Key.Escape && root.dialog-open {
                root.settings-open = false;
                root.sign-in-open = false;
                root.picker-open = false;
                root.eq-open = false;
                return accept;
            }
            if ev.text == Key.Escape && root.queue-selected > 0 {
                root.queue-clear-selection();
                return accept;
            }
            if ev.text == Key.Delete && root.queue-selected > 0 && !top-bar.search-focused && !root.dialog-open {
                root.queue-remove-selected();
                return accept;
            }
            if ev.text == " " && !top-bar.search-focused {
                root.toggle-play();
                return accept;
            }
            if ev.modifiers.control && (ev.text == "f" || ev.text == "k" || ev.text == "l") {
                top-bar.focus-input();
                return accept;
            }
            if ev.modifiers.control && ev.text == "b" {
                root.toggle-sidebar();
                return accept;
            }
            if ev.modifiers.control && ev.text == Key.RightArrow {
                root.next();
                return accept;
            }
            if ev.modifiers.control && ev.text == Key.LeftArrow {
                root.previous();
                return accept;
            }
            if ev.modifiers.alt && ev.text == Key.LeftArrow {
                root.back();
                return accept;
            }
            if ev.modifiers.alt && ev.text == Key.RightArrow {
                root.forward();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-left: Theme.gap;
            padding-right: Theme.gap;

            // Top bar
            // On the instance, as Slint ignores `z` on a component's own root;
            // it keeps the search dropdown over the panels below.
            top-bar := TopBar {
                z: 10;
                can-back: root.can-back;
                can-forward: root.can-forward;
                nav-current: root.nav-current;
                search-text <=> root.search-text;
                suggestions: root.suggestions;
                recent-searches: root.recent-searches;
                account-photo: root.account-photo;
                update-version: root.update-version;
                settings-open <=> root.settings-open;
                back => { root.back(); }
                forward => { root.forward(); }
                go(nav) => { root.go(nav); }
                search(q) => { root.search(q); }
                search-edited(q) => { root.search-edited(q); }
                forget-search(q) => { root.forget-search(q); }
                release-focus => { keys.focus(); }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: Theme.gap;

                // Your Library
                sidebar := Sidebar {
                    sidebar-collapsed: root.sidebar-collapsed;
                    nav-current: root.nav-current;
                    library: root.library;
                    sign-in-open <=> root.sign-in-open;
                    toggle-sidebar => { root.toggle-sidebar(); }
                    go(nav) => { root.go(nav); }
                }

                // Main panel
                main := PageView {
                    rows: root.rows;
                    page-loading: root.page-loading;
                    page-error: root.page-error;
                    page-title: root.page-title;
                    page-can-play: root.page-can-play;
                    accent: root.accent;
                    nav-current: root.nav-current;
                    page-scroll <=> root.page-scroll;
                    sign-in-open <=> root.sign-in-open;
                    go(nav) => { root.go(nav); }
                }

                // Up next and lyrics
                SidePanel {
                    panel-open <=> root.panel-open;
                    panel-tab <=> root.panel-tab;
                    np-accent: root.np-accent;
                    queue: root.queue;
                    queue-selected: root.queue-selected;
                    lyrics: root.lyrics;
                    lyrics-synced: root.lyrics-synced;
                    lyrics-current: root.lyrics-current;
                    lyrics-source: root.lyrics-source;
                    lyrics-loading: root.lyrics-loading;
                    queue-clicked(index, control, shift) => { root.queue-clicked(index, control, shift); }
                    queue-move(from, to) => { root.queue-move(from, to); }
                    queue-remove(index) => { root.queue-remove(index); }
                    queue-remove-selected => { root.queue-remove-selected(); }
                    queue-play-next(index) => { root.queue-play-next(index); }
                    queue-play-next-selected => { root.queue-play-next-selected(); }
                    queue-clear-selection => { root.queue-clear-selection(); }
                    queue-clear => { root.queue-clear(); }
                    queue-save => { root.queue-save(); }
                    panel-tab-changed(tab) => { root.panel-tab-changed(tab); }
                    lyric-clicked(index) => { root.lyric-clicked(index); }
                }
            }

            // Player bar
            PlayerBar {
                has-track: root.has-track;
                np-title: root.np-title;
                np-artists: root.np-artists;
                np-art: root.np-art;
                np-duration: root.np-duration;
                np-position: root.np-position;
                np-buffered: root.np-buffered;
                np-playing: root.np-playing;
                np-loading: root.np-loading;
                np-premium: root.np-premium;
                np-quality: root.np-quality;
                np-has-artist: root.np-has-artist;
                np-has-album: root.np-has-album;
                volume: root.volume;
                muted: root.muted;
                shuffle: root.shuffle;
                smart-shuffle: root.smart-shuffle;
                repeat-mode: root.repeat-mode;
                panel-open: root.panel-open;
                panel-tab: root.panel-tab;
                toggle-play => { root.toggle-play(); }
                next => { root.next(); }
                previous => { root.previous(); }
                seek(f) => { root.seek(f); }
                set-volume(v) => { root.set-volume(v); }
                toggle-mute => { root.toggle-mute(); }
                toggle-shuffle => { root.toggle-shuffle(); }
                cycle-repeat => { root.cycle-repeat(); }
                np-go-artist => { root.np-go-artist(); }
                np-go-album => { root.np-go-album(); }
                open-panel(tab) => { root.open-panel(tab); }
            }
        }

        // Toast
        Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - Theme.player-bar - self.height - (root.toast-visible ? 20px : 0px);
            width: min(toast-text.preferred-width + 40px, root.width - 64px);
            height: toast-text.preferred-height + 22px;
            border-radius: 8px;
            background: Theme.text;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;
            opacity: root.toast-visible ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity, y {
                duration: Theme.normal;
                easing: ease-out;
            }
            toast-text := Text {
                width: parent.width - 40px;
                text: root.toast;
                wrap: word-wrap;
                horizontal-alignment: center;
                font-size: 14px;
                font-weight: 600;
                color: #000000;
            }
        }

        if root.settings-shown: SettingsDialog {
            settings-open <=> root.settings-open;
            eq-open <=> root.eq-open;
            sign-in-open <=> root.sign-in-open;
            quality: root.quality;
            premium-status: root.premium-status;
            normalise: root.normalise;
            crossfade: root.crossfade;
            equaliser: root.equaliser;
            eq-presets: root.eq-presets;
            eq-preset: root.eq-preset;
            autoplay: root.autoplay;
            discord: root.discord;
            update-status: root.update-status;
            update-version: root.update-version;
            update-busy: root.update-busy;
            check-updates: root.check-updates;
            set-quality(i) => { root.set-quality(i); }
            set-normalise(v) => { root.set-normalise(v); }
            set-crossfade(v) => { root.set-crossfade(v); }
            set-autoplay(v) => { root.set-autoplay(v); }
            set-discord(v) => { root.set-discord(v); }
            set-check-updates(v) => { root.set-check-updates(v); }
            install-update => { root.install-update(); }
            sign-out => { root.sign-out(); }
        }

        EqualiserDialog {
            eq-open <=> root.eq-open;
            equaliser <=> root.equaliser;
            eq-gains: root.eq-gains;
            eq-bands: root.eq-bands;
            eq-presets: root.eq-presets;
            eq-preset: root.eq-preset;
            eq-max-db: root.eq-max-db;
            set-equaliser(on) => { root.set-equaliser(on); }
            set-eq-preset(index) => { root.set-eq-preset(index); }
            set-eq-band(band, value, done) => { root.set-eq-band(band, value, done); }
        }

        PlaylistPicker {
            picker-open <=> root.picker-open;
            picker-loading: root.picker-loading;
            playlist-choices: root.playlist-choices;
            pick-playlist(index) => { root.pick-playlist(index); }
        }

        if root.sign-in-shown: SignInDialog {
            signing-in: root.signing-in;
            signing-in-browser: root.signing-in-browser;
            sign-in-error: root.sign-in-error;
            pasted-cookie <=> root.pasted-cookie;
            sign-in-open <=> root.sign-in-open;
            sign-in(cookie) => { root.sign-in(cookie); }
            sign-in-browser() => { root.sign-in-browser(); }
        }
    }
}

/// Holds Google's sign-in page, which the app places over it.
export component SignInWindow inherits Window {
    title: "Sign in to YouTube Music";
    icon: @image-url("../app-icon.png");
    background: Theme.background;
    preferred-width: 480px;
    preferred-height: 700px;
    min-width: 400px;
    min-height: 560px;
    callback resized();
    changed width => { root.resized(); }
    changed height => { root.resized(); }
}
