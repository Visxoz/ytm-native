import { EqualiserDialog } from "dialogs/equaliser.slint";
import { PlaylistPicker } from "dialogs/playlist-picker.slint";
import { SettingsDialog } from "dialogs/settings.slint";
import { SignInDialog } from "dialogs/sign-in.slint";
import { SidePanel } from "panel/side-panel.slint";
import { FullPlayer } from "shell/full-player.slint";
import { MiniPlayer } from "mini-player.slint";
import { PageView } from "shell/page-view.slint";
import { PlayerBar } from "shell/player-bar.slint";
import { Sidebar } from "shell/sidebar.slint";
import { TopBar } from "shell/top-bar.slint";
import { Toast } from "shell/toast.slint";
import { UpdateCard } from "shell/update-card.slint";
import { Theme } from "theme.slint";
import { AccentChoice, Api, CardItem, PlaylistChoice, QueueItem, RowItem, RowKind, TrackItem } from "types.slint";
import { Palette } from "std-widgets.slint";

export {
    MiniPlayer,
    Api,
    Theme,
    TrackItem,
    CardItem,
    RowItem,
    RowKind,
    QueueItem,
    PlaylistChoice,
    AccentChoice,
}

/// Whether a dialog is in the tree: from opening until its closing
/// animation has played.
component Linger {
    in property <bool> open;
    out property <bool> shown;
    changed open => {
        if root.open {
            root.shown = true;
        } else {
            closer.running = true;
        }
    }
    closer := Timer {
        interval: Theme.normal;
        running: false;
        triggered => {
            self.running = false;
            root.shown = root.open;
        }
    }
}

export component AppWindow inherits Window {
    title: "Lily";
    background: Theme.background;
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 960px;
    min-height: 620px;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    in property <[RowItem]> rows;
    in property <bool> page-loading;
    in property <string> page-shape;
    in property <string> page-error;
    in property <string> page-title;
    in property <bool> page-can-play;
    in property <color> accent: transparent;
    in property <string> nav-current: "home";
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <[string]> suggestions;
    in property <[string]> recent-searches;
    in-out property <string> search-text;
    in-out property <length> page-scroll;

    in property <bool> has-track;
    in property <string> np-title;
    in property <string> np-artists;
    in property <image> np-art;
    /// The artwork at the full player's size, while it is open.
    in property <image> np-cover;
    /// The artwork's colours, blended, behind the full player.
    in property <image> np-backdrop;
    in property <color> np-accent: #3a3a3a;
    in property <float> np-duration;
    in property <float> np-position;
    in property <float> np-buffered;
    in property <bool> np-loading;
    in property <bool> np-premium;
    in property <string> np-quality;
    in property <bool> np-has-artist;
    in property <bool> np-has-album;
    in-out property <float> volume: 0.8;
    in property <bool> muted;
    in property <bool> shuffle;
    in property <bool> smart-shuffle;
    in property <int> repeat-mode;
    in-out property <bool> full-player <=> root.full-screen;
    in property <bool> mini-open;
    /// The queue's drawer over the full player's lyrics.
    out property <bool> queue-drawer;
    /// The queue entry that plays after this one, as `Queue::next_index`
    /// picks it, or -1 when none or the same one does.
    property <int> up-next: root.repeat-mode == 2 ? -1
        : root.queue-current + 1 < root.queue.length ? root.queue-current + 1
        : root.repeat-mode != 0 && root.queue.length > 0 ? 0 : -1;
    out property <bool> queue-shown: root.full-player ? root.queue-drawer : root.panel-open && root.panel-tab == 0;
    out property <bool> lyrics-shown: root.full-player || (root.panel-open && root.panel-tab == 1);

    in-out property <bool> sidebar-collapsed;
    in property <[CardItem]> library;
    in-out property <bool> panel-open;
    in-out property <int> panel-tab;
    in property <[QueueItem]> queue;
    in property <int> queue-current;
    in property <int> queue-selected;
    in property <[string]> lyrics;
    in property <bool> lyrics-synced;
    in property <int> lyrics-current: -1;
    in property <string> lyrics-source;
    in property <bool> lyrics-loading;

    in property <image> account-photo;
    in property <bool> signing-in;
    in property <bool> signing-in-browser;
    in property <string> sign-in-error;
    in-out property <bool> settings-open;
    in-out property <bool> sign-in-open;
    in property <int> normalise: 2;
    in property <bool> discord;
    in property <bool> autoplay;
    in property <bool> youtube-history;
    in property <bool> rating-buttons;
    /// 0 low, 1 normal, 2 high.
    in property <int> quality: 2;
    in property <bool> crossfade;
    in property <bool> close-to-tray;
    /// "System default", then each output device; the chosen one's index,
    /// or -1 while it is unplugged.
    in property <[string]> output-devices;
    in property <int> output-device;
    in property <string> output-detail;
    /// The speeds offered, and the index of the one playing, or -1.
    in property <[string]> speeds;
    in property <int> speed;
    in property <string> premium-status;
    in property <[AccentChoice]> accents;
    in property <int> accent-choice;
    // Last.fm: whether this build has its keys, the connected account's
    // name or empty, and whether it waits for the user in the browser.
    in property <bool> lastfm-available;
    in property <string> lastfm-user;
    in property <bool> lastfm-connecting;
    property <bool> eq-open;
    in-out property <bool> equaliser;
    in property <[float]> eq-gains;
    in property <[string]> eq-bands;
    in property <[string]> eq-presets;
    /// The preset the gains match, or -1.
    in property <int> eq-preset;
    in property <float> eq-max-db;
    in-out property <bool> picker-open;
    in property <bool> picker-loading;
    in property <[PlaylistChoice]> playlist-choices;
    // A newer version to install, or empty, and the Updates row's text.
    in property <string> update-version;
    in property <string> update-status;
    in property <bool> update-busy;
    in property <float> update-progress;
    /// The update card, until "Later".
    in-out property <bool> update-prompt;
    in property <bool> check-updates;
    in property <[string]> local-folders;
    /// What the proxy row says, and the user's own proxy saved, without any
    /// password.
    in property <string> proxy-detail;
    in property <string> proxy-address;

    in property <string> toast;
    in property <bool> toast-visible;
    /// Flipped after restoring from minimised: the full-window background
    /// changes by one shade, forcing a complete repaint.
    in property <bool> repaint-flip;

    callback go(nav: string);
    callback back();
    callback forward();
    callback search(query: string);
    callback search-edited(query: string);
    callback forget-search(query: string);
    callback toggle-play();
    callback next();
    callback previous();
    callback seek(fraction: float);
    callback set-volume(value: float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback queue-clicked(index: int, control: bool, shift: bool);
    callback queue-move(from: int, to: int);
    callback queue-remove(index: int);
    callback queue-remove-selected();
    callback queue-play-next(index: int);
    callback queue-play-next-selected();
    callback queue-clear-selection();
    callback queue-clear();
    callback queue-save();
    callback panel-tab-changed(tab: int);
    callback lyric-clicked(index: int);
    callback full-player-changed();
    callback toggle-mini-player();
    callback sidebar-changed(collapsed: bool);
    callback np-go-artist();
    callback np-go-album();
    callback sign-in(cookie: string);
    callback sign-in-browser();
    callback sign-out();
    callback set-normalise(value: int);
    callback set-discord(value: bool);
    callback set-check-updates(value: bool);
    callback install-update();
    callback remove-folder(index: int);
    /// Saves a proxy for the next start, or Windows' for an empty address,
    /// answering why the address won't do, or nothing.
    callback set-proxy(address: string) -> string;
    callback pick-playlist(index: int);
    callback set-autoplay(value: bool);
    callback set-youtube-history(value: bool);
    callback set-rating-buttons(value: bool);
    callback set-quality(value: int);
    callback set-crossfade(value: bool);
    callback set-close-to-tray(value: bool);
    callback list-output-devices();
    callback set-output-device(index: int);
    callback set-speed(index: int);
    callback set-look(index: int);
    callback set-accent(index: int);
    callback lastfm-connect();
    /// Also stops waiting for a connection.
    callback lastfm-disconnect();
    callback set-equaliser(on: bool);
    callback set-eq-preset(index: int);
    /// A band's slider, from 0 to 1, moved; `done` once it is let go.
    callback set-eq-band(band: int, value: float, done: bool);
    // Delivered from background threads through the event loop.
    callback player-event(kind: string, message: string);
    callback media-action(action: string, value: float);
    callback local-files-changed();

    changed settings-open => {
        if root.settings-open {
            root.list-output-devices();
        } else {
            keys.focus();
        }
    }

    changed full-player => {
        root.queue-drawer = false;
        root.full-player-changed();
    }

    /// The full player always shows the lyrics, so there the queue's button
    /// toggles its drawer and the lyrics' button closes it.
    function open-panel(tab: int) {
        if root.full-player {
            root.queue-drawer = tab == 0 && !root.queue-drawer;
            if root.queue-drawer {
                root.panel-tab-changed(0);
            }
        } else if root.panel-open && root.panel-tab == tab {
            root.panel-open = false;
        } else {
            root.panel-open = true;
            root.panel-tab = tab;
            root.panel-tab-changed(tab);
        }
    }

    // Std widgets, such as the sign-in dialog's text box, follow the look.
    property <bool> light: Theme.light;
    init => { Palette.color-scheme = root.light ? ColorScheme.light : ColorScheme.dark; }
    changed light => { Palette.color-scheme = root.light ? ColorScheme.light : ColorScheme.dark; }

    property <bool> dialog-open: root.settings-open || root.sign-in-open || root.picker-open || root.eq-open;

    function toggle-sidebar() {
        root.sidebar-collapsed = !root.sidebar-collapsed;
        root.sidebar-changed(root.sidebar-collapsed);
    }

    settings-linger := Linger {
        open: root.settings-open;
    }
    sign-in-linger := Linger {
        open: root.sign-in-open;
    }

    public function focus-search() {
        top-bar.focus-input();
    }

    public function close-search() {
        if top-bar.search-focused {
            top-bar.close();
        }
    }

    /// Closes the search box on a press outside it (logical pixels from the
    /// window's corner): rows and cards take no focus, so it would stay open.
    public function close-search-outside(x: length, y: length) {
        if top-bar.search-focused && !top-bar.contains(x, y) {
            top-bar.close();
        }
    }

    Rectangle {
        background: root.repaint-flip ? Theme.background.mix(Theme.ink, 0.995) : Theme.background;
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(ev) => {
            if ev.text == Key.Escape && root.dialog-open {
                root.settings-open = false;
                root.sign-in-open = false;
                root.picker-open = false;
                root.eq-open = false;
                return accept;
            }
            if ev.text == Key.Escape && root.queue-selected > 0 && root.queue-shown {
                root.queue-clear-selection();
                return accept;
            }
            if ev.text == Key.Escape && root.queue-drawer {
                root.queue-drawer = false;
                return accept;
            }
            if ev.text == Key.Escape && root.full-player {
                root.full-player = false;
                return accept;
            }
            if ev.text == Key.Delete && root.queue-selected > 0 && root.queue-shown && !top-bar.search-focused && !root.dialog-open {
                root.queue-remove-selected();
                return accept;
            }
            if ev.text == " " && !top-bar.search-focused {
                root.toggle-play();
                return accept;
            }
            if ev.modifiers.control && ev.text == Key.RightArrow {
                root.next();
                return accept;
            }
            if ev.modifiers.control && ev.text == Key.LeftArrow {
                root.previous();
                return accept;
            }
            // The rest act on the page and bars, which the full player hides.
            if root.full-player {
                return reject;
            }
            if ev.modifiers.control && (ev.text == "f" || ev.text == "k" || ev.text == "l") {
                top-bar.focus-input();
                return accept;
            }
            if ev.modifiers.control && ev.text == "b" {
                root.toggle-sidebar();
                return accept;
            }
            if ev.modifiers.alt && ev.text == Key.LeftArrow {
                root.back();
                return accept;
            }
            if ev.modifiers.alt && ev.text == Key.RightArrow {
                root.forward();
                return accept;
            }
            reject
        }

        if root.full-player: FullPlayer {
            art: root.np-cover.width > 0 ? root.np-cover : root.np-art;
            backdrop: root.np-backdrop;
            title: root.np-title;
            artists: root.np-artists;
            next: root.up-next < 0 ? "" : "Next: " + root.queue[root.up-next].title + "  •  " + root.queue[root.up-next].artists;
            lyrics: root.lyrics;
            lyrics-synced: root.lyrics-synced;
            lyrics-current: root.lyrics-current;
            lyrics-source: root.lyrics-source;
            lyrics-loading: root.lyrics-loading;
            lyric-clicked(index) => { root.lyric-clicked(index); }
            drawer-width: side-panel.width;
        }

        // The full player hides the top bar, sidebar and page, keeping their
        // state; the panel becomes its queue's drawer.
        VerticalLayout {
            padding-left: Theme.gap;
            padding-right: Theme.gap;

            // On the instance, as Slint ignores `z` on a component's own root;
            // it keeps the search dropdown over the panels below.
            top-bar := TopBar {
                z: 10;
                visible: !root.full-player;
                can-back: root.can-back;
                can-forward: root.can-forward;
                nav-current: root.nav-current;
                search-text <=> root.search-text;
                suggestions: root.suggestions;
                recent-searches: root.recent-searches;
                account-photo: root.account-photo;
                update-version: root.update-version;
                settings-open <=> root.settings-open;
                back => { root.back(); }
                forward => { root.forward(); }
                go(nav) => { root.go(nav); }
                search(q) => { root.search(q); }
                search-edited(q) => { root.search-edited(q); }
                forget-search(q) => { root.forget-search(q); }
                release-focus => { keys.focus(); }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: Theme.gap;

                sidebar := Sidebar {
                    visible: !root.full-player;
                    sidebar-collapsed: root.sidebar-collapsed;
                    nav-current: root.nav-current;
                    library: root.library;
                    sign-in-open <=> root.sign-in-open;
                    toggle-sidebar => { root.toggle-sidebar(); }
                    go(nav) => { root.go(nav); }
                }

                main := PageView {
                    visible: !root.full-player;
                    rows: root.rows;
                    page-loading: root.page-loading;
                    page-shape: root.page-shape;
                    page-error: root.page-error;
                    page-title: root.page-title;
                    page-can-play: root.page-can-play;
                    accent: root.accent;
                    nav-current: root.nav-current;
                    page-scroll <=> root.page-scroll;
                    sign-in-open <=> root.sign-in-open;
                    go(nav) => { root.go(nav); }
                }

                side-panel := SidePanel {
                    shown: root.full-player ? root.queue-drawer : root.panel-open;
                    full-player: root.full-player;
                    panel-tab <=> root.panel-tab;
                    np-accent: root.np-accent;
                    queue: root.queue;
                    queue-selected: root.queue-selected;
                    lyrics: root.lyrics;
                    lyrics-synced: root.lyrics-synced;
                    lyrics-current: root.lyrics-current;
                    lyrics-source: root.lyrics-source;
                    lyrics-loading: root.lyrics-loading;
                    queue-clicked(index, control, shift) => { root.queue-clicked(index, control, shift); }
                    queue-move(from, to) => { root.queue-move(from, to); }
                    queue-remove(index) => { root.queue-remove(index); }
                    queue-remove-selected => { root.queue-remove-selected(); }
                    queue-play-next(index) => { root.queue-play-next(index); }
                    queue-play-next-selected => { root.queue-play-next-selected(); }
                    queue-clear-selection => { root.queue-clear-selection(); }
                    queue-clear => { root.queue-clear(); }
                    queue-save => { root.queue-save(); }
                    panel-tab-changed(tab) => { root.panel-tab-changed(tab); }
                    close => {
                        if root.full-player {
                            root.queue-drawer = false;
                        } else {
                            root.panel-open = false;
                        }
                    }
                    lyric-clicked(index) => { root.lyric-clicked(index); }
                }
            }

            PlayerBar {
                has-track: root.has-track;
                rating-buttons: root.rating-buttons;
                np-title: root.np-title;
                np-artists: root.np-artists;
                np-art: root.np-art;
                np-duration: root.np-duration;
                np-position: root.np-position;
                np-buffered: root.np-buffered;
                np-loading: root.np-loading;
                np-premium: root.np-premium;
                np-quality: root.np-quality;
                np-has-artist: root.np-has-artist;
                np-has-album: root.np-has-album;
                volume: root.volume;
                muted: root.muted;
                shuffle: root.shuffle;
                smart-shuffle: root.smart-shuffle;
                repeat-mode: root.repeat-mode;
                full-player <=> root.full-player;
                mini-open: root.mini-open;
                toggle-mini-player => { root.toggle-mini-player(); }
                queue-active: root.queue-shown;
                lyrics-active: root.full-player ? !root.queue-drawer : root.lyrics-shown;
                toggle-play => { root.toggle-play(); }
                next => { root.next(); }
                previous => { root.previous(); }
                seek(f) => { root.seek(f); }
                set-volume(v) => { root.set-volume(v); }
                toggle-mute => { root.toggle-mute(); }
                toggle-shuffle => { root.toggle-shuffle(); }
                cycle-repeat => { root.cycle-repeat(); }
                np-go-artist => { root.np-go-artist(); }
                np-go-album => { root.np-go-album(); }
                open-panel(tab) => { root.open-panel(tab); }
            }
        }

        // Beneath the toast, which stays readable over it.
        UpdateCard {
            x: root.width - self.width - 2 * Theme.gap;
            y: root.height - Theme.player-bar - self.height - self.lift;
            width: 360px;
            shown: root.update-prompt;
            status: root.update-status;
            busy: root.update-busy;
            progress: root.update-progress;
            install => { root.install-update(); }
            later => { root.update-prompt = false; }
        }

        Toast {
            x: (root.width - self.width) / 2;
            y: root.height - Theme.player-bar - self.height - self.lift;
            limit: min(480px, root.width - 64px);
            shown: root.toast-visible;
            text: root.toast;
        }

        if settings-linger.shown: SettingsDialog {
            settings-open <=> root.settings-open;
            eq-open <=> root.eq-open;
            sign-in-open <=> root.sign-in-open;
            quality: root.quality;
            premium-status: root.premium-status;
            normalise: root.normalise;
            crossfade: root.crossfade;
            output-devices: root.output-devices;
            output-device: root.output-device;
            output-detail: root.output-detail;
            set-output-device(i) => { root.set-output-device(i); }
            list-output-devices => { root.list-output-devices(); }
            speeds: root.speeds;
            speed: root.speed;
            set-speed(i) => { root.set-speed(i); }
            equaliser: root.equaliser;
            eq-presets: root.eq-presets;
            eq-preset: root.eq-preset;
            autoplay: root.autoplay;
            discord: root.discord;
            update-status: root.update-status;
            update-version: root.update-version;
            update-busy: root.update-busy;
            check-updates: root.check-updates;
            accents: root.accents;
            accent-choice: root.accent-choice;
            close-to-tray: root.close-to-tray;
            set-close-to-tray(v) => { root.set-close-to-tray(v); }
            lastfm-available: root.lastfm-available;
            lastfm-user: root.lastfm-user;
            lastfm-connecting: root.lastfm-connecting;
            set-quality(i) => { root.set-quality(i); }
            lastfm-connect => { root.lastfm-connect(); }
            lastfm-disconnect => { root.lastfm-disconnect(); }
            set-look(i) => { root.set-look(i); }
            set-accent(i) => { root.set-accent(i); }
            set-normalise(v) => { root.set-normalise(v); }
            set-crossfade(v) => { root.set-crossfade(v); }
            set-autoplay(v) => { root.set-autoplay(v); }
            youtube-history: root.youtube-history;
            set-youtube-history(v) => { root.set-youtube-history(v); }
            rating-buttons: root.rating-buttons;
            set-rating-buttons(v) => { root.set-rating-buttons(v); }
            set-discord(v) => { root.set-discord(v); }
            set-check-updates(v) => { root.set-check-updates(v); }
            install-update => { root.install-update(); }
            local-folders: root.local-folders;
            proxy-detail: root.proxy-detail;
            proxy-address: root.proxy-address;
            add-folder => { root.go("add-folder"); }
            remove-folder(i) => { root.remove-folder(i); }
            set-proxy(address) => { return root.set-proxy(address); }
            release-focus => { keys.focus(); }
            sign-out => { root.sign-out(); }
        }

        EqualiserDialog {
            eq-open <=> root.eq-open;
            equaliser <=> root.equaliser;
            eq-gains: root.eq-gains;
            eq-bands: root.eq-bands;
            eq-presets: root.eq-presets;
            eq-preset: root.eq-preset;
            eq-max-db: root.eq-max-db;
            set-equaliser(on) => { root.set-equaliser(on); }
            set-eq-preset(index) => { root.set-eq-preset(index); }
            set-eq-band(band, value, done) => { root.set-eq-band(band, value, done); }
        }

        PlaylistPicker {
            picker-open <=> root.picker-open;
            picker-loading: root.picker-loading;
            playlist-choices: root.playlist-choices;
            pick-playlist(index) => { root.pick-playlist(index); }
        }

        if sign-in-linger.shown: SignInDialog {
            signing-in: root.signing-in;
            signing-in-browser: root.signing-in-browser;
            sign-in-error: root.sign-in-error;
            sign-in-open <=> root.sign-in-open;
            sign-in(cookie) => { root.sign-in(cookie); }
            sign-in-browser() => { root.sign-in-browser(); }
        }
    }
}

/// Holds Google's sign-in page, which the app places over it.
export component SignInWindow inherits Window {
    title: "Sign in to YouTube Music";
    // White like Google's page, which covers it once loaded, in every look.
    background: #ffffff;
    preferred-width: 480px;
    preferred-height: 700px;
    min-width: 400px;
    min-height: 560px;
    callback resized();
    changed width => { root.resized(); }
    changed height => { root.resized(); }
}
